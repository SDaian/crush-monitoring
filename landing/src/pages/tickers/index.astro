---
// "/tickers" — index of the most-traded stocks in the disclosure data, each
// linking to its own page. Internal-linking hub for the /tickers/<slug> set
// and its own landing target ("what stocks does Congress trade").
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Seo from "../../components/Seo.astro";
import SignupForm from "../../components/SignupForm.astro";
import SignupModal from "../../components/SignupModal.astro";
import index from "../../data/tickers/_index.json";
import { plural, seoDescription } from "../../lib/seo";

const tickers = index.tickers;
const totalTrades = tickers.reduce((n: number, t: any) => n + t.trades, 0);

// Industry options, built from the stocks actually on this page — an option
// that matches nothing is worse than no option. Count each one so the reader
// sees the size of a group before they pick it. `classified` drives the
// fineprint: an unbadged stock is unclassified, not industry-less, and the
// page has to say which.
const industryCount = new Map<string, number>();
for (const t of tickers as any[]) {
  if (t.industry) {
    industryCount.set(t.industry.key, (industryCount.get(t.industry.key) ?? 0) + 1);
  }
}
const industries = Object.entries(index.industries as Record<string, string>)
  .filter(([key]) => industryCount.has(key))
  .map(([key, label]) => ({ key, label, count: industryCount.get(key)! }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
const classified = [...industryCount.values()].reduce((n, v) => n + v, 0);

const title =
  "What stocks does Congress trade? — the most-traded tickers · Capitol Ledger";
const description = seoDescription(
  `The ${plural(tickers.length, "stock")} members of Congress trade most, ` +
    `ranked across ${plural(totalTrades, "disclosed trade")} — who bought, ` +
    "who sold, how much.",
  "One page per ticker.",
);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Most-traded stocks in Congress",
    description,
    hasPart: tickers.map((t: any) => ({
      "@type": "WebPage",
      name: `${t.ticker} congressional stock trades`,
      url: `https://capitolledger.io/tickers/${t.slug}`,
    })),
  },
];
---

<html lang="en">
  <head>
    <Seo title={title} description={description} path="/tickers" schema={schema} />
  </head>
  <body>
    <Header active="tickers" />

    <main id="content">
    <section class="mx-auto max-w-[75rem] px-[5vw] pt-[9vh] pb-[6vh]">
      <p class="eyebrow mb-5">
        Stocks · <b class="font-semibold text-stamp">Most traded</b>
      </p>
      <h1 class="headline max-w-[18ch] text-[clamp(2.4rem,6.5vw,4.6rem)]">
        What Congress <span class="underline-stamp">actually buys</span>.
      </h1>
      <p class="mt-6 max-w-[56ch] text-[1.05rem] leading-[1.65] text-pretty text-ink-soft">
        The {tickers.length} tickers that show up most in congressional
        disclosures — {totalTrades.toLocaleString("en-US")} trades in total. Open
        any one to see which members traded it, the buy/sell split, and a link to
        every official filing.
      </p>
    </section>

    <section class="mx-auto max-w-[75rem] px-[5vw] pb-6">
      <div id="tfilter" class="tctl" hidden>
        <label class="tctl-search">
          <span class="sr-only">Filter the stocks</span>
          <input
            id="tq"
            type="search"
            autocomplete="off"
            placeholder="Filter by ticker or company"
          />
        </label>
        <label class="tctl-sort tctl-ind">
          <span class="eyebrow">Industry</span>
          <select id="tind">
            <option value="">All ({tickers.length})</option>
            {
              industries.map((i) => (
                <option value={i.key}>
                  {i.label} ({i.count})
                </option>
              ))
            }
          </select>
        </label>
        <label class="tctl-sort">
          <span class="eyebrow">Sort</span>
          <select id="tsort">
            <option value="trades">Most traded</option>
            <option value="name">A–Z</option>
            <option value="members">Most members</option>
          </select>
        </label>
        <button
          id="tstars"
          class="tctl-stars"
          hidden
          aria-pressed="false"
          title="Stars are saved in this browser only">★ Starred</button>
        <p id="tcount" class="eyebrow tctl-count" aria-live="polite" />
      </div>
    </section>

    <section class="mx-auto max-w-[75rem] px-[5vw] pb-[10vh]">
      <div id="tgrid" class="grid grid-cols-2 gap-x-10 gap-y-1 max-[720px]:grid-cols-1">
        {
          tickers.map((t: any) => (
            <a
              href={`/tickers/${t.slug}`}
              class="tcard"
              data-t={t.ticker.toLowerCase()}
              data-c={(t.company ?? "").toLowerCase()}
              data-trades={t.trades}
              data-members={t.members}
              data-i={t.industry?.key ?? ""}
            >
              <div class="tcard-name">
                {t.ticker}
                <span class="tcard-co">{t.company}</span>
              </div>
              <div class="tcard-stat">
                {t.industry && <span class="tcard-ind">{t.industry.label}</span>}
                <span class="tcard-counts">
                  <b>{t.trades.toLocaleString("en-US")}</b> trades ·{" "}
                  <b>{t.members}</b> members
                </span>
                <span class="tcard-split">
                  <span class="whitespace-nowrap">
                    <span class="text-buy">{t.buys} buy</span>/<span class="text-sell">{t.sells} sell</span>
                  </span>
                  <span class="tcard-go">View →</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
      <p id="tempty" class="mt-8 text-ink-soft" hidden>
        No stock matches that filter. Every disclosed trade is still on the
        <a href="/tracker" class="underline underline-offset-2 hover:text-ink"
          >full tracker</a
        >.
      </p>
      <p class="fineprint mt-8 max-w-[80ch]">
        Ranked by number of disclosed trades across all filers. Only tickers with
        enough disclosed activity get a page — the rest are searchable on the
        <a
          href="/tracker"
          class="underline underline-offset-2 hover:text-ink">full tracker</a
        >. The industry on each stock is <b class="text-ink">our own grouping</b>,
        not an official classification, and it covers{" "}
        <b class="text-ink">{classified} of the {tickers.length}</b> stocks here —
        an unlabelled stock is one we have not classified. Disclosures arrive
        30–45 days after the trade; nothing here is investment advice.
      </p>
    </section>

    <section class="border-t-2 border-ink px-[5vw] py-[10vh] text-center">
      <h2 class="text-[clamp(1.8rem,4.5vw,3.2rem)] font-black leading-[1.15] tracking-[-0.03em] text-balance">
        See the next trade as it's filed.
      </h2>
      <p class="mx-auto mt-4 mb-6 max-w-[46ch] text-pretty text-ink-soft">
        {totalTrades.toLocaleString("en-US")} trades across these
        {" "}{tickers.length} tickers so far. Every new one lands in one
        morning email.
      </p>
      <SignupForm variant="band" id="join" />
    </section>
    </main>


    <Footer />

    <SignupModal />
  </body>
</html>

<script is:inline>
  // Filter and sort the stock list. The page ships all 97 rows in the HTML,
  // so a crawler still reads every link; this only hides and reorders them.
  // The controls start hidden and this script reveals them, so a reader
  // without JavaScript never sees a control that cannot work.
  (function () {
    var box = document.getElementById("tfilter");
    var grid = document.getElementById("tgrid");
    var q = document.getElementById("tq");
    var indSel = document.getElementById("tind");
    var sortSel = document.getElementById("tsort");
    var starsBtn = document.getElementById("tstars");
    var count = document.getElementById("tcount");
    var empty = document.getElementById("tempty");
    if (!box || !grid || !q || !indSel || !sortSel || !starsBtn || !count || !empty)
      return;

    var rows = Array.prototype.slice.call(grid.querySelectorAll(".tcard"));
    var total = rows.length;
    var num = function (el, name) {
      return parseInt(el.getAttribute(name) || "0", 10) || 0;
    };

    // Stars come from the StarButton helper when a starred page loaded it;
    // this page has no star buttons of its own, so read the key directly.
    function starred() {
      try {
        var raw = JSON.parse(localStorage.getItem("cl-stars")) || {};
        return Array.isArray(raw.tickers) ? raw.tickers : [];
      } catch (e) {
        return [];
      }
    }
    var starsOnly = false;

    function apply() {
      var term = q.value.trim().toLowerCase();
      var ind = indSel.value;
      var stars = starred();
      var shown = 0;
      rows.forEach(function (row) {
        var hit =
          (!term ||
            row.getAttribute("data-t").indexOf(term) !== -1 ||
            row.getAttribute("data-c").indexOf(term) !== -1) &&
          (!ind || row.getAttribute("data-i") === ind) &&
          (!starsOnly ||
            stars.indexOf(row.getAttribute("data-t").toUpperCase()) !== -1);
        row.hidden = !hit;
        if (hit) shown++;
      });
      empty.hidden = shown !== 0;
      count.textContent =
        shown === total
          ? total + " stocks"
          : shown + " of " + total + " stocks";
    }

    // Mark the starred cards, and reveal the toggle only when stars exist:
    // a filter over an empty set is a control that cannot work.
    function paintStars() {
      var stars = starred();
      rows.forEach(function (row) {
        row.classList.toggle(
          "is-starred",
          stars.indexOf(row.getAttribute("data-t").toUpperCase()) !== -1,
        );
      });
      starsBtn.hidden = stars.length === 0 && !starsOnly;
    }

    // A stock page links here as /tickers?industry=tech, so the select has to
    // honour the query string. An unknown value leaves the select on "All"
    // rather than showing an empty grid the reader cannot explain.
    function fromQuery() {
      var want = new URLSearchParams(location.search).get("industry");
      if (!want) return;
      for (var i = 0; i < indSel.options.length; i++) {
        if (indSel.options[i].value === want) {
          indSel.value = want;
          return;
        }
      }
    }

    function sort() {
      var mode = sortSel.value;
      var ordered = rows.slice().sort(function (a, b) {
        if (mode === "name") {
          return a.getAttribute("data-t").localeCompare(b.getAttribute("data-t"));
        }
        var key = mode === "members" ? "data-members" : "data-trades";
        // Ties keep the ticker order, so the list never shuffles at random.
        return (
          num(b, key) - num(a, key) ||
          a.getAttribute("data-t").localeCompare(b.getAttribute("data-t"))
        );
      });
      ordered.forEach(function (row) {
        grid.appendChild(row);
      });
    }

    q.addEventListener("input", apply);
    starsBtn.addEventListener("click", function () {
      starsOnly = !starsOnly;
      starsBtn.classList.toggle("on", starsOnly);
      starsBtn.setAttribute("aria-pressed", starsOnly ? "true" : "false");
      apply();
    });
    indSel.addEventListener("change", function () {
      var url = new URL(location.href);
      if (indSel.value) url.searchParams.set("industry", indSel.value);
      else url.searchParams.delete("industry");
      history.replaceState(null, "", url);
      apply();
    });
    sortSel.addEventListener("change", function () {
      sort();
      apply();
    });
    box.hidden = false;
    fromQuery();
    paintStars();
    apply();
  })();
</script>

<style>
  .tctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    border-top: 2px solid var(--color-ink);
    border-bottom: 1px solid var(--color-rule);
    padding: 0.9rem 0;
  }
  .tctl-search {
    flex: 1 1 22rem;
    min-width: 0;
  }
  .tctl-search input {
    width: 100%;
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    padding: 0.7rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-ink);
  }
  .tctl-search input:focus {
    outline: 2px solid var(--color-ink);
    outline-offset: -1px;
  }
  .tctl-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .tctl-sort select {
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    padding: 0.55rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink);
    min-width: 0;
    max-width: 100%;
  }
  /* A <select> takes its intrinsic width from its longest option, so the
     industry list pushed the control off a 320px screen. It shrinks now, and
     sectors.json caps every label at 21 characters so nothing clips. */
  .tctl-ind {
    flex: 1 1 16rem;
  }
  .tctl-ind select {
    flex: 1 1 auto;
  }
  .tctl-count {
    margin-left: auto;
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .tctl {
      gap: 0.6rem 0.8rem;
    }
    .tctl-search,
    .tctl-ind {
      flex: 1 1 100%;
    }
    /* Label above, select across the row. Beside the label the control kept
       only 213px of a 320px screen, and "Health care & pharma (14)" clipped
       inside it — an overflow no scrollWidth check reports. */
    .tctl-ind {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
    }
    .tctl-search input,
    .tctl-sort select {
      font-size: 0.82rem;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tcard {
    display: block;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: var(--color-ink);
  }
  .tcard:hover .tcard-name,
  .tcard:focus-visible .tcard-name {
    color: var(--color-stamp);
  }
  .tcard-name {
    font-weight: 900;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    letter-spacing: -0.02em;
    transition: color 0.15s;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }
  .tcard-co {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.78rem;
    letter-spacing: 0;
    color: var(--color-ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tcard-stat {
    font-family: var(--font-mono);
    font-size: 0.83rem;
    color: var(--color-ink-soft);
    margin-top: 0.75rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }
  .tcard-stat b {
    color: var(--color-ink);
    font-weight: 600;
  }
  /* Facts wrap as whole units, never mid-thought: the counts pair and the
     buy/sell split each hold together, and the dot between the two lives in
     CSS so it can never dangle at a line end. */
  .tcard-counts {
    white-space: nowrap;
  }
  .tcard-counts::after {
    content: " ·";
  }
  .tcard-split {
    display: flex;
    flex: 1 1 auto;
    align-items: baseline;
    gap: 0.75rem;
    white-space: nowrap;
  }
  /* Phone: the badge is a label, so it heads the numbers on its own row;
     the counts take the next; View pins to the buy/sell row's right edge. */
  @media (max-width: 40rem) {
    .tcard-stat {
      display: block;
    }
    .tcard-ind {
      display: inline-block;
      margin-bottom: 0.6rem;
    }
    .tcard-counts {
      display: block;
      margin-bottom: 0.4rem;
    }
    .tcard-counts::after {
      content: none;
    }
  }
  /* The star toggle and card marker (roadmap personal section, stage A).
     Marker classes are set at runtime, so they ride the global StarButton
     rules' reasoning — but these selectors exist at build time, so scoped
     styles work: Astro tags the elements, JS only flips classes. */
  .tctl-stars {
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    padding: 0.55rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    cursor: pointer;
  }
  .tctl-stars:hover,
  .tctl-stars:focus-visible {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
  .tctl-stars.on {
    color: var(--color-paper);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }
  .tcard.is-starred .tcard-name::before {
    content: "★ ";
    color: var(--color-stamp);
  }

  /* One box for all fourteen industries, deliberately. The identity carries a
     single accent, and colour-coding the set would need fourteen hues the
     token set does not have. */
  .tcard-ind {
    border: 1px solid var(--color-rule);
    padding: 0.12rem 0.45rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    white-space: nowrap;
  }
  .tcard-go {
    margin-left: auto;
    color: var(--color-stamp);
    font-weight: 600;
  }
</style>
