    <CountUp />

    <script>
      // Wires the tab bar. The head script already painted the right panel;
      // this only handles clicks, keys and the address bar. Deep links keep
      // working: the tracker links #technical, and each section keeps its id
      // inside its panel, so the anchor still resolves.
      const root = document.documentElement;
      const tabs = [
        document.getElementById("tab-trades"),
        document.getElementById("tab-tech"),
      ].filter(Boolean) as HTMLButtonElement[];

      if (tabs.length === 2) {
        const show = (tech: boolean, focus = false) => {
          root.classList.toggle("t-tech", tech);
          tabs.forEach((tab, i) => {
            const on = i === (tech ? 1 : 0);
            tab.setAttribute("aria-selected", on ? "true" : "false");
            tab.tabIndex = on ? 0 : -1;
            if (on && focus) tab.focus();
          });
          // Keep the URL honest, without pushing a history entry per click.
          history.replaceState(null, "", tech ? "#technical" : location.pathname);
        };

        show(root.classList.contains("t-tech"));
        tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i === 1)));
        document.querySelector(".tktabs")?.addEventListener("keydown", (e) => {
          const key = (e as KeyboardEvent).key;
          if (key !== "ArrowRight" && key !== "ArrowLeft") return;
          e.preventDefault();
          show(!root.classList.contains("t-tech"), true);
        });
        // A #technical link followed while already on the page. The browser
        // tried to scroll to a target that was still hidden, so the jump has
        // to happen after the panel opens.
        addEventListener("hashchange", () => {
          const tech = /^#(technical|market)$/.test(location.hash);
          show(tech);
          if (tech) document.getElementById("technical")?.scrollIntoView();
        });
      }
    </script>
