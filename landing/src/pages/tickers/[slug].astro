---
// "/tickers/<slug>" — one page per heavily-traded ticker: which members of
// Congress traded it, the buy/sell split, and the most recent disclosed trades
// with a link to each official filing (landing/src/data/tickers/*.json).
//
// The universe is picked by SUBSTANCE in landing_data.select_ticker_pages (the
// most-traded tickers clearing a minimum), not by the featured watchlist — a
// pile of thin auto-generated pages is an SEO liability, not an asset. Scaling
// to every ticker is the storage-stage-1 trigger in ROADMAP.md.
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Seo from "../../components/Seo.astro";
import SignupForm from "../../components/SignupForm.astro";
import SignupModal from "../../components/SignupModal.astro";
import CountUp from "../../components/CountUp.astro";
import MarketStrip from "../../components/MarketStrip.astro";
import StarButton from "../../components/StarButton.astro";
import marketData from "../../data/market.json";
import { plural, seoDescription } from "../../lib/seo";

// Build-time "checked" date: when this page was last regenerated. Deliberately
// computed here, not stamped into the data files — a timestamp in the payload
// would make every generated JSON diff daily even when nothing changed.
const checkedOn = new Date().toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});


export async function getStaticPaths() {
  const all = import.meta.glob("../../data/tickers/*.json", { eager: true });
  return Object.entries(all)
    .filter(([path]) => !path.endsWith("/_index.json"))
    .map(([, mod]) => {
      const t = (mod as { default: any }).default;
      return { params: { slug: t.slug }, props: { t } };
    });
}

const { t } = Astro.props as { t: any };
const s = t.summary;

const fmtDate = (iso: string | null) =>
  iso
    ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
      })
    : "—";
const fmtMonth = (iso: string | null) =>
  iso
    ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      })
    : "—";

const STAT_CARDS = [
  { n: s.trades.toLocaleString("en-US"), l: "trades disclosed" },
  { n: s.members.toLocaleString("en-US"), l: "members trading" },
  { n: s.buys.toLocaleString("en-US"), l: "buys" },
  { n: s.sells.toLocaleString("en-US"), l: "sells" },
];

// Search intent here is "<ticker> congress trades" / "who in congress owns
// <company>" — lead the title with the symbol, keep the company name in it.
// --- Technical read (featured watchlist only) -------------------------
const tech: any = (t as any).technical ?? null;
// Market-wide volatility, generated once and imported by every ticker page —
// see landing/src/data/market.json. Null on a source outage; the strip then
// renders nothing.
const market = (marketData as any).market ?? null;
const num = (v: any, suffix = "", digits = 2) =>
  v === null || v === undefined ? "—" : `${Number(v).toFixed(digits)}${suffix}`;
const signed = (v: any) =>
  v === null || v === undefined ? "—" : `${v > 0 ? "+" : ""}${Number(v).toFixed(2)}%`;
const dirClass = (v: any) =>
  v === null || v === undefined ? "" : v > 0 ? "text-buy" : v < 0 ? "text-sell" : "";

// The weekly-close chart. Built here as inline SVG: no chart library and no
// client JS (DESIGN.md). The y-scale spans the DAILY 52-week low/high, not
// the weekly series range, so the chart and the "52-week range" cell below
// it can never state two different numbers for the same idea.
const pts: any[] = tech?.series ?? [];

function buildChart(w: number, h: number, fs: number) {
  if (pts.length < 2 || !tech) return null;
  const closes = pts.map((p: any) => p.c);
  const lo = Math.min(tech.low52w ?? Math.min(...closes), ...closes);
  const hi = Math.max(tech.high52w ?? Math.max(...closes), ...closes);
  // Pad the scale so the 52-week hairlines sit inside the plot. Without it
  // the low line lands on the baseline and the area fill swallows it.
  const pad = (hi - lo || 1) * 0.06;
  const yLo = lo - pad;
  const span = hi + pad - yLo || 1;
  // Right gutter holds the two range labels; the bottom band holds the dates.
  const padR = fs * 5.2;
  const padT = fs * 1.1;
  const padB = fs * 2.0;
  const plotW = w - padR;
  const plotH = h - padT - padB;
  const x = (i: number) => (i / (pts.length - 1)) * plotW;
  const y = (v: number) => padT + (1 - (v - yLo) / span) * plotH;
  const line = closes
    .map((c: number, i: number) => `${x(i).toFixed(1)},${y(c).toFixed(1)}`)
    .join(" ");
  const month = (iso: string) =>
    new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    });
  return {
    w, h, fs, line,
    area: `0,${(padT + plotH).toFixed(1)} ${line} ${plotW.toFixed(1)},${(padT + plotH).toFixed(1)}`,
    yHigh: y(hi).toFixed(1),
    yLow: y(lo).toFixed(1),
    hi: hi.toFixed(2),
    lo: lo.toFixed(2),
    dotX: x(pts.length - 1).toFixed(1),
    dotY: y(closes[closes.length - 1]).toFixed(1),
    last: closes[closes.length - 1].toFixed(2),
    plotW: plotW.toFixed(1),
    labelX: (plotW + fs * 0.5).toFixed(1),
    baseY: (padT + plotH).toFixed(1),
    dateY: (h - fs * 0.4).toFixed(1),
    firstMonth: month(pts[0].d),
    lastMonth: month(pts[pts.length - 1].d),
    weeks: pts.length,
  };
}

// Two geometries. SVG text scales with the viewBox, so one geometry stretched
// to both widths would render the labels at the wrong size on a phone.
const chartDesk = buildChart(1000, 300, 14);
const chartMob = buildChart(520, 340, 19);

const cells = tech
  ? [
      { k: "Price", v: num(tech.price), x: `as of ${tech.asOf}` },
      { k: "1 day", v: signed(tech.chg1d), cls: dirClass(tech.chg1d) },
      { k: "1 week", v: signed(tech.chg1w), cls: dirClass(tech.chg1w) },
      { k: "1 month", v: signed(tech.chg1m), cls: dirClass(tech.chg1m) },
      { k: "RSI (14)", v: num(tech.rsi14, "", 1),
        x: tech.rsi14 == null ? "" : tech.rsi14 < 30 ? "oversold" : tech.rsi14 > 70 ? "overbought" : "neutral" },
      { k: "vs 50-day", v: signed(tech.vsSma50), cls: dirClass(tech.vsSma50),
        x: `avg ${num(tech.sma50)}` },
      { k: "vs 200-day", v: signed(tech.vsSma200), cls: dirClass(tech.vsSma200),
        x: `avg ${num(tech.sma200)}` },
      { k: "52-week range", v: tech.rangePos == null ? "—" : `${tech.rangePos}%`,
        x: `${num(tech.low52w)} – ${num(tech.high52w)}` },
      { k: "Rel. volume", v: tech.relVol == null ? "—" : `${num(tech.relVol)}x`,
        x: "vs 20-day average" },
    ]
  : [];
const scoreClass = tech
  ? { "Strong Buy": "text-buy", Buy: "text-buy", "Strong Sell": "text-sell",
      Sell: "text-sell", Hold: "text-ink-soft" }[tech.score.label] ?? ""
  : "";

const title = `${t.ticker} congressional stock trades — who in Congress bought and sold · Capitol Ledger`;
// Front-loaded with this ticker's own numbers — the company name goes in an
// optional tail clause because it is the one part whose length we do not
// control ("Taiwan Semiconductor Manufacturing Company Ltd." alone is 47).
const description = seoDescription(
  `${plural(s.members, "member")} of Congress disclosed ` +
    `${plural(s.trades, `${t.ticker} trade`)} — ${plural(s.buys, "buy")}, ` +
    `${plural(s.sells, "sell")}, the amounts and how late each filing arrived.`,
  `${t.company}.`,
);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `${t.ticker} — stock trades disclosed by members of Congress`,
    description,
    creator: { "@type": "Organization", name: "Capitol Ledger" },
    isAccessibleForFree: true,
    license: "https://www.usa.gov/government-works",
    temporalCoverage:
      s.firstTx && s.lastTx ? `${s.firstTx}/${s.lastTx}` : undefined,
    variableMeasured: ["member", "transaction type", "amount bracket", "filing delay"],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Stocks", item: "/tickers" },
      { "@type": "ListItem", position: 2, name: t.ticker },
    ],
  },
];
---

<html lang="en">
  <head>
    <Seo
      title={title}
      description={description}
      path={`/tickers/${t.slug}`}
      schema={schema}
      noindex={t.indexable === false}
    />
    {/* Runs before the body parses, so the right panel is the only one ever
         painted: no flash, no layout shift. It sets two classes and nothing
         else. Without JavaScript neither class lands and both panels show,
         which is the page exactly as it read before the tabs. */}
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add("js");
        if (/^#(technical|market)$/.test(location.hash)) r.classList.add("t-tech");
      })();
    </script>
  </head>
  <body>
    <Header active="tickers" />

    <main id="content">
    <section class="mx-auto max-w-[75rem] px-[5vw] pt-[9vh] pb-[6vh]">
      <p class="eyebrow mb-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <span>
          <a href="/tickers" class="no-underline hover:text-ink">Stocks</a> ·
          <b class="font-semibold text-stamp">{t.company}</b>
        </span>
        {s.lastFiling && (
          <span>Newest filing <b class="font-semibold text-ink">{fmtDate(s.lastFiling)}</b></span>
        )}
      </p>
      <h1 class="headline max-w-[16ch] text-[clamp(2.4rem,6.5vw,4.6rem)]">
        Congress trades <span class="underline-stamp">{t.ticker}</span>.
      </h1>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        {
          t.industry && (
            <a class="indbadge" href={`/tickers?industry=${t.industry.key}`}>
              {t.industry.label} <span aria-hidden="true">→</span>
            </a>
          )
        }
        <StarButton kind="tickers" id={t.ticker} name={t.ticker} />
      </div>
      <p class="mt-6 max-w-[58ch] text-[1.05rem] leading-[1.65] text-pretty text-ink-soft">
        {s.members} member{s.members === 1 ? "" : "s"} of Congress have disclosed
        {" "}{s.trades.toLocaleString("en-US")} trades in {t.company} between
        {" "}{fmtMonth(s.firstTx)} and {fmtMonth(s.lastTx)} — {s.buys} buys and
        {" "}{s.sells} sells. Amounts are the brackets as filed; timing is counted
        against the 45-day legal maximum.
      </p>
      {/* Same split as member pages: newest filing in the header's right
           meta, "checked" (our rebuild date) down here. */}
      <p class="mono mt-5 text-[.75rem] uppercase tracking-[.08em] text-ink-soft">
        Checked {checkedOn}
      </p>
    </section>

    {/* Two tabs, right under the headline: the numbers a reader comes for
         must not sit a full scroll below the trades table. Both panels are in
         the HTML — the script only hides one — so search engines read the
         whole page and a no-JS reader gets it as one long page. */}
    <div class="mx-auto max-w-[75rem] px-[5vw]">
      <div class="tktabs" role="tablist" aria-label={`${t.ticker} sections`}>
        <button
          id="tab-trades"
          class="tktab"
          role="tab"
          type="button"
          aria-selected="true"
          aria-controls="panel-trades">Disclosed trades</button
        >
        <button
          id="tab-tech"
          class="tktab"
          role="tab"
          type="button"
          aria-selected="false"
          tabindex="-1"
          aria-controls="panel-tech">Market &amp; technicals</button
        >
      </div>
    </div>

    <div id="panel-trades" class="tkpanel" role="tabpanel" aria-labelledby="tab-trades">
    <section class="mx-auto max-w-[75rem] px-[5vw] pt-[4vh] pb-[7vh]">
      <div class="statstrip">
        {
          STAT_CARDS.map((c) => (
            <div class="stat">
              <div class="statnum stat-n">{c.n}</div>
              <div class="statlabel">{c.l}</div>
            </div>
          ))
        }
      </div>
      <p class="fineprint mt-5 max-w-[85ch]">
        Disclosed dollar flow, by bracket midpoint: <b class="text-ink"
          >~{s.estBuyLabel}</b
        > bought against <b class="text-ink">~{s.estSellLabel}</b> sold. Filings
        report ranges, not exact amounts — these are directional estimates, never
        real position sizes, and {s.pctLate}% of these filings arrived past the
        legal deadline.
      </p>
    </section>

    {
      t.topMembers.length > 0 && (
        <section class="mx-auto max-w-[75rem] px-[5vw] pb-[7vh]">
          <div class="section-head">
            <h2 class="section-title whitespace-nowrap">
              Who trades {t.ticker}
            </h2>
            <span class="eyebrow">Most active filers first</span>
          </div>
          <div class="mt-8">
            {t.topMembers.map((m: any) => (
              <div class="mrow">
                <div class="mname">
                  {m.hasPage ? (
                    <a href={`/members/${m.slug}`}>{m.name}</a>
                  ) : (
                    m.name
                  )}
                  <small>
                    {m.party} · {m.chamber}
                  </small>
                </div>
                <div class="msplit">
                  <span class="text-buy">{m.buys} buy</span>
                  <span class="text-ink-soft">/</span>
                  <span class="text-sell">{m.sells} sell</span>
                </div>
                <div class="mcount">
                  {m.trades}×<small>~{m.estLabel}</small>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="mx-auto max-w-[75rem] px-[5vw] pb-[6vh]">
      <div class="section-head">
        <h2 class="section-title whitespace-nowrap">Recent {t.ticker} trades</h2>
        <span class="eyebrow">
          Most recent {t.tradesShown} of {s.trades}
        </span>
      </div>

      <p class="tswipe" aria-hidden="true">swipe →</p>
      <div class="tscroll">
        <div role="table" aria-label={`${t.ticker} trades disclosed by Congress`}>
          <div role="row" class="trow thead">
            <span role="columnheader">Member</span>
            <span role="columnheader">Side</span>
            <span role="columnheader">Amount</span>
            <span role="columnheader">Traded</span>
            <span role="columnheader">Filing</span>
          </div>
          {
            t.trades.map((r: any) => (
              <div role="row" class="trow">
                <div role="cell" class="ttick">
                  {r.hasPage ? (
                    <a href={`/members/${r.memberSlug}`} class="mlink">
                      {r.member}
                    </a>
                  ) : (
                    r.member
                  )}
                  <small>{r.party}</small>
                </div>
                <div
                  role="cell"
                  class={`tside font-semibold ${r.side === "BUY" ? "text-buy" : "text-sell"}`}
                >
                  {r.side}
                </div>
                <div role="cell" class="tamt">{r.amountBucket}</div>
                <div role="cell" class="tdate">
                  {fmtDate(r.txDate)}
                  <small>filed {fmtDate(r.filedDate)}</small>
                </div>
                <div role="cell" class="tlate">
                  {r.daysLate && r.daysLate > 0 ? (
                    <span class="latebad">{r.daysLate}d late</span>
                  ) : (
                    <span class="lateok">on time</span>
                  )}
                  {r.sourceUrl && (
                    <a
                      href={r.sourceUrl}
                      class="tsrc"
                      rel="nofollow"
                      aria-label="Official filing"
                    >
                      filing ↗
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <p class="fineprint mt-6 max-w-[80ch]">
        Every row links to the official filing it came from. Amounts are the
        brackets as filed; "days late" counts days past the STOCK Act's 45-day
        maximum (<a
          href="/how-it-works"
          class="underline underline-offset-2 hover:text-ink">how we count</a
        >). Disclosures arrive 30–45 days after the trade, so this is a public
        record — never real-time, and never investment advice.
      </p>
    </section>
    </div>

    <div id="panel-tech" class="tkpanel" role="tabpanel" aria-labelledby="tab-tech">
    {/* The weather every one of these trades happened in. One market-wide
         number, so it is identical on every ticker page and says so. */}
    {/* Tight to the tab bar on purpose: the strip is the first thing the tab
         promises, and a viewport-sized gap (4vh) read as a loading page. */}
    <section class="mx-auto max-w-[75rem] px-[5vw] pt-6 pb-7">
      <MarketStrip reading={market} subject={t.ticker} />
    </section>

    {
      tech ? (
        <section id="technical" class="mx-auto max-w-[75rem] px-[5vw] pb-[7vh]">
          <div class="section-head">
            <h2 class="section-title whitespace-nowrap">Technical read</h2>
            <span class="eyebrow">Daily snapshot · {tech.asOf}</span>
          </div>

          <p class="fineprint mt-4 max-w-[80ch]">
            Mechanical readings computed from past daily closes — the same ones
            the morning report scores. A daily snapshot,{" "}
            <b class="text-ink">not real-time</b>, and{" "}
            <b class="text-ink">not investment advice</b>.
          </p>

          {chartDesk && chartMob && (
            <figure class="mt-7 cwrap">
              {[chartDesk, chartMob].map((c: any, idx: number) => (
                <svg
                  class={idx === 0 ? "cdesk" : "cmob"}
                  viewBox={`0 0 ${c.w} ${c.h}`}
                  role="img"
                  aria-label={`${t.ticker} weekly closes over the last year: ${c.last}, in a 52-week range of ${c.lo} to ${c.hi}`}
                >
                  <polyline points={c.area} fill="var(--color-wash)" stroke="none" />
                  {/* 52-week range: solid hairlines, one shade off the paper.
                      Never dashed — a dash reads as a projection. Drawn AFTER
                      the area, or the fill hides the low one. */}
                  <line x1="0" x2={c.plotW} y1={c.yHigh} y2={c.yHigh}
                    stroke="var(--color-rule)" stroke-width="1" />
                  <line x1="0" x2={c.plotW} y1={c.yLow} y2={c.yLow}
                    stroke="var(--color-rule)" stroke-width="1" />
                  <polyline points={c.line} fill="none"
                    stroke="var(--color-stamp)" stroke-width="2"
                    stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                  {/* The current close. The ring keeps the dot readable where
                      it sits on the line. */}
                  <circle cx={c.dotX} cy={c.dotY} r={c.fs * 0.42}
                    fill="var(--color-stamp)"
                    stroke="var(--color-paper)" stroke-width="2" />
                  <text x={c.labelX} y={c.yHigh} dy="0.32em"
                    font-size={c.fs} fill="var(--color-ink-soft)"
                    font-family="var(--font-mono)">{c.hi}</text>
                  <text x={c.labelX} y={c.yLow} dy="0.32em"
                    font-size={c.fs} fill="var(--color-ink-soft)"
                    font-family="var(--font-mono)">{c.lo}</text>
                  <text x={c.labelX} y={c.dotY} dy="0.32em"
                    font-size={c.fs} fill="var(--color-ink)" font-weight="700"
                    font-family="var(--font-mono)">{c.last}</text>
                  <text x="0" y={c.dateY} font-size={c.fs * 0.85}
                    fill="var(--color-ink-soft)" font-family="var(--font-mono)"
                  >{c.firstMonth}</text>
                  <text x={c.plotW} y={c.dateY} text-anchor="end"
                    font-size={c.fs * 0.85} fill="var(--color-ink-soft)"
                    font-family="var(--font-mono)"
                  >{c.lastMonth}</text>
                </svg>
              ))}
              <figcaption class="fineprint mt-2">
                Weekly closes, last {chartDesk.weeks} weeks. The two hairlines
                mark the 52-week low and high; the dot marks the latest close.
              </figcaption>
            </figure>
          )}

          <div class="mt-7 grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(11rem,1fr))]">
            {cells.map((c: any) => (
              <div class="indcell">
                <div class="k">{c.k}</div>
                <div class={`v ${c.cls ?? ""}`}>{c.v}</div>
                {c.x && <div class="x">{c.x}</div>}
              </div>
            ))}
          </div>

          <div class="mt-7 border border-rule p-5">
            <div class="eyebrow">Mechanical summary</div>
            <p class="mt-2 text-lg font-bold">
              <span class={scoreClass}>{tech.score.label}</span>
              <span class="ml-2 text-sm font-normal text-ink-soft">
                {tech.score.buys} buy · {tech.score.holds} hold ·{" "}
                {tech.score.sells} sell votes
              </span>
            </p>
            <p class="fineprint mt-3 max-w-[80ch]">
              A rule-based tally of the indicators shown above — each casts one
              buy/hold/sell vote (price vs. its 20/50/200-day averages, the
              50-vs-200 cross, RSI, and the 1-week and 1-month changes). It is
              reproducible and blind to fundamentals, news and your own goals.
              <b class="text-ink"> Not a recommendation.</b>
            </p>
          </div>

          {(tech.signals.length > 0 || tech.nextEarnings) && (
            <div class="mt-7">
              <div class="eyebrow">Worth keeping in mind</div>
              <ul class="mt-3 space-y-2">
                {tech.signals.map((sig: any) => (
                  <li class="text-sm">
                    <b class="mono">{sig.label}</b>{" "}
                    <span class="text-ink-soft">· {sig.asof}</span>
                  </li>
                ))}
                {tech.nextEarnings && (
                  <li class="text-sm">
                    <b class="mono">Next earnings: {tech.nextEarnings.date}</b>
                    {tech.nextEarnings.time && (
                      <span class="text-ink-soft"> · {tech.nextEarnings.time}</span>
                    )}
                  </li>
                )}
              </ul>
            </div>
          )}
        </section>
      ) : (
        // No reading for this symbol. Say why and where the readings are —
        // an empty tab would read as a broken page.
        <section id="technical" class="mx-auto max-w-[75rem] px-[5vw] pb-[7vh]">
          <div class="section-head">
            <h2 class="section-title whitespace-nowrap">Technical read</h2>
            <span class="eyebrow">Not published for {t.ticker}</span>
          </div>
          <p class="fineprint mt-5 max-w-[80ch]">
            We publish mechanical readings — price against its 20/50/200-day
            averages, RSI, the 52-week range — for every stock with enough
            disclosed trades to earn a page here. {t.ticker} is below that bar
            today, so this page carries its disclosure record and the market
            reading above.{" "}
            <a href="/tracker" class="underline underline-offset-2 hover:text-ink"
              >See the stocks we do read →</a
            >
          </p>
        </section>
      )
    }
    </div>

    <section class="border-t-2 border-ink px-[5vw] py-[10vh] text-center">
