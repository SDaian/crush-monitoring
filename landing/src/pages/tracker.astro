  /* ── Table ────────────────────────────────────────────────────── */
  .tracker .tblwrap { overflow-x: auto; margin-top: 0.75rem; }
  .tracker table { width: 100%; border-collapse: collapse; }
  .tracker thead th {
    position: sticky;
    top: 0;
    z-index: 1;
