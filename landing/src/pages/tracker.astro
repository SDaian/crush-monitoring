---
// "/tracker" — the full searchable trade record + the featured-stocks
// technical scorecard, as a native page in the Capitol Ledger design system
// (ported from the standalone docs/trades.html, which now redirects here).
//
// Deliberately TRIMMED: the old "Ticker focus" and "Holdings" tabs are gone —
// /tickers/<symbol> and /members/<slug> do that job better as static, indexable
// pages. What is left is what only a client-side app can do: filter 12k+ rows,
// and render the daily indicator scorecard.
//
// Data is fetched at runtime from /data/*.json, copied out of docs/data at
// build time by scripts/copy-tracker-data.mjs (single source of truth in git).
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import SignupForm from "../components/SignupForm.astro";
import SignupModal from "../components/SignupModal.astro";
import { seoDescription } from "../lib/seo";
import memberIndex from "../data/members/_index.json";
import tickerIndex from "../data/tickers/_index.json";

// Which member/ticker pages exist, resolved at BUILD time from the same
// generated indexes that build those pages — so a feed row can deep-link
// without ever minting a dead link. Full filer name → slug (the trades JSON
// carries full names); ticker → slug.
const MEMBER_PAGES = Object.fromEntries(
  (memberIndex as any).members.map((m: any) => [m.name, m.slug]),
);
const TICKER_PAGES = Object.fromEntries(
  (tickerIndex as any).tickers.map((t: any) => [t.ticker, t.slug]),
);

const title = "Congressional stock-trade tracker — search every disclosure · Capitol Ledger";
const description = seoDescription(
  "Search every stock trade disclosed by Congress and the executive branch " +
    "— filter by member, ticker, chamber, party or date.",
  "Every row links to its filing.",
);
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Capitol Ledger trade tracker",
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    description,
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
];
---

<html lang="en">
  <head>
    <Seo title={title} description={description} path="/tracker" schema={schema} />
  </head>
  <body>
    <Header active="tracker" />

    <section class="mx-auto max-w-[85rem] px-[5vw] pt-[9vh] pb-[5vh]">
      <p class="eyebrow mb-5">
        Tracker · <b class="font-semibold text-stamp">Every disclosure</b>
      </p>
      <h1 class="headline max-w-[20ch] text-[clamp(2.2rem,5.5vw,4rem)]">
        The whole <span class="underline-stamp">record</span>, searchable.
      </h1>
      <p class="mt-6 max-w-[60ch] text-[1.05rem] leading-[1.65] text-pretty text-ink-soft">
        Every trade disclosed under the STOCK Act — filter by member, ticker,
        chamber, party or date, and open the official filing behind any row.
        Disclosures arrive 30–45 days after the trade and amounts are brackets,
        never exact. Not investment advice.
      </p>
    </section>

    <div class="tracker mx-auto max-w-[85rem] px-[5vw] pb-[10vh]">
      <div class="tabs" id="tabs" role="tablist">
        <button class="tab active" data-p="p-all" role="tab" aria-selected="true">
          📊 All trades
        </button>
        <button class="tab" data-p="p-ai" role="tab" aria-selected="false">
          ⭐ Featured stocks
        </button>
        <a class="tab tab-link" href="/tickers">🔎 By ticker →</a>
        <a class="tab tab-link" href="/members">🧩 Holdings by member →</a>
      </div>

      <!-- ── All trades ────────────────────────────────────────────── -->
      <section class="panel active" id="p-all">
        <div class="filters">
          <input type="search" id="q" placeholder="Search member or ticker…" />
          <select id="fChamber">
            <option value="">Chamber: all</option>
            <option value="house">House</option>
            <option value="senate">Senate</option>
            <option value="executive">Executive (President)</option>
          </select>
          <select id="fParty">
            <option value="">Party: all</option>
            <option value="D">Democratic</option>
            <option value="R">Republican</option>
            <option value="I">Independent</option>
          </select>
          <select id="fType">
            <option value="">Type: all</option>
            <option value="buy">Buy</option>
            <option value="sell">Sell</option>
            <option value="exchange">Exchange</option>
          </select>
          <select id="fAsset">
            <option value="equity" selected>Stocks &amp; options</option>
            <option value="bond">Bonds &amp; debt</option>
            <option value="">Assets: all</option>
          </select>
          <select id="fRange">
            <option value="90">Last 90 days</option>
            <option value="365">Last year</option>
            <option value="" selected>All data</option>
          </select>
          <button class="act" id="clearBtn">✕ Clear</button>
        </div>

        <div class="count" id="countLine">Loading disclosures…</div>
        <div class="note" id="retLegend"></div>

        <div class="tblwrap">
          <table id="tbl">
            <thead><tr id="headRow"></tr></thead>
            <tbody id="rows"></tbody>
          </table>
        </div>
        <div class="morewrap">
          <button class="act" id="moreBtn" style="display:none">Show 200 more</button>
        </div>
      </section>

      <!-- ── Featured stocks ───────────────────────────────────────── -->
      <section class="panel" id="p-ai" hidden>
        <div class="banner-sample" id="aiSampleBanner" style="display:none">
          ⚠️ These indicators are <b>sample data from a synthetic price series —
          not real market data.</b> The daily refresh replaces them with real
          closes once the price feed runs.
        </div>
        <p class="legend">
          <b>Mechanical technical indicators</b> for a featured stock universe —
          RSI(14), moving averages, volume and the 52-week range, recomputed
          <b>daily</b> from Twelve Data closes, plus a <b>transparent
          buy/sell/hold summary</b> that is just a <b>rule-based tally of those
          indicators</b> (each casts a vote, full breakdown shown) — <b>not
          investment advice</b>, and blind to fundamentals, news and your own
          goals. A <b>daily snapshot, not real-time</b>.
        </p>
        <div id="aiSignals" class="aisignals"></div>
        <div class="cards" id="aiCards"></div>
        <div class="filters">
          <input type="search" id="aiq" placeholder="Analyze a ticker (e.g. NVDA)…" />
          <button class="act" id="aiClearBtn">✕ Clear</button>
        </div>
        <div class="panel2" id="aiDetail"></div>
      </section>
    </div>

    <section class="border-t-2 border-ink px-[5vw] py-[10vh] text-center">
      <h2 class="text-[clamp(1.8rem,4.5vw,3.2rem)] font-black leading-[1.15] tracking-[-0.03em] text-balance">
        Stop refreshing this page.
      </h2>
      <p class="mx-auto mt-4 mb-8 max-w-[44ch] text-pretty text-ink-soft">
        Every new disclosure lands in one email each morning — no filtering
        required.
      </p>
      <SignupForm variant="band" id="join" />
    </section>

    <Footer />

    <SignupModal title="Stop refreshing. Start reading." />

    <script is:inline id="pagemaps" type="application/json" set:html={JSON.stringify({ members: MEMBER_PAGES, tickers: TICKER_PAGES })} />
    <script is:inline>
      // ── State + constants ──────────────────────────────────────────────
      // Pages that exist for deep-linking (built at build time; see frontmatter).
      const PAGEMAPS = JSON.parse(document.getElementById("pagemaps").textContent);
      const COLS = [
        {key:"member",     label:"Member"},
        {key:"ticker",     label:"Ticker"},
        {key:"asset",      label:"Asset"},
        {key:"type",       label:"Type"},
        {key:"amount_lo",  label:"Amount", num:true},
        {key:"_ret",       label:"Since buy", num:true},
        {key:"tx_date",    label:"Traded", num:true},
        {key:"filing_date",label:"Filed", num:true},
        {key:"source_url", label:"Filing", nosort:true},
      ];
      const PAGE = 200;

      let DATA = null;
      let RET = {};       // trade id -> {entry_date, entry_close, pct}
      let PRICES = {};    // ticker -> {asof_date, asof_close}
      let AI = {};        // ticker -> {name, price, rsi14, sma20/50/200, …}
      let AI_META = {};
      let retSample = false;
      let aiSample = false;
      let state = {q:"", chamber:"", party:"", type:"", range:"", member:"", asset:"equity",
                   sortKey:"filing_date", sortDir:-1, shown:PAGE, aiTicker:"NVDA"};

      const $ = id => document.getElementById(id);
      const esc = s => String(s ?? "").replace(/[&<>"']/g,
        c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
      function daysAgo(n){
        const d = new Date(); d.setDate(d.getDate() - n);
        return d.toISOString().slice(0,10);
      }

      // Ticker-less debt rows (Trump's managed-account bonds, munis,
      // treasuries; House code CS is corporate bonds/notes). Mirrors the
      // Python landing_data.is_bond — a tickered row is never a bond here.
      const BOND_TYPES = new Set([
        "bond", "Corporate Bond", "Municipal Security",
        "Government Security", "Corporate Security",
      ]);
      const isBond = t => !t.ticker && BOND_TYPES.has(t.asset_type);

      function filtered(){
        const q = state.q.trim().toLowerCase();
        const since = state.range ? daysAgo(+state.range) : "";
        return DATA.trades.filter(t =>
          (!state.member || t.member === state.member) &&
          (!q || t.member.toLowerCase().includes(q) || (t.ticker||"").toLowerCase().includes(q)) &&
          (!state.chamber || t.chamber === state.chamber) &&
          (!state.party || t.party === state.party) &&
          (!state.type || t.type === state.type) &&
          (!state.asset || (state.asset === "bond") === isBond(t)) &&
          (!since || t.tx_date >= since)
        );
      }

      // An option's or coin's price move isn't the underlying stock's, so never
      // show a "since buy" equity return for those even though they carry a ticker.
      const RET_BLOCK = new Set(["Option", "Cryptocurrency"]);
      function retFor(t){
        if (t.type !== "buy" || RET_BLOCK.has(t.asset_type)) return null;
        return RET[t.id];
      }

      function sortVal(t, k){
        if (k === "_ret"){ const r = retFor(t); return r ? r.pct : -Infinity; }
        return t[k] ?? "";
      }

      function sorted(rows){
        const k = state.sortKey, dir = state.sortDir;
        return rows.slice().sort((a,b) => {
          const va = sortVal(a, k), vb = sortVal(b, k);
          if (va < vb) return -dir;
          if (va > vb) return dir;
          return a.id < b.id ? -1 : 1;
        });
      }

      function retCell(t){
        const r = retFor(t);
        if (!r) return '<span class="muted">—</span>';
        const px = PRICES[t.ticker];
        const tip = `Stock ${r.pct >= 0 ? "up" : "down"} since the disclosed buy — `
          + `entry $${r.entry_close} on ${r.entry_date}`
          + (px ? ` → $${px.asof_close} on ${px.asof_date}` : "")
          + ` (estimate, not member profit)`;
        return `<span class="${r.pct >= 0 ? "buy" : "sell"}" title="${esc(tip)}">`
          + `${r.pct >= 0 ? "+" : ""}${r.pct}%</span>`;
      }

      function optionText(t){
        // Only options carry this; show what the filer disclosed, never invented.
        if (t.asset_type !== "Option" && !t.option) return "";
        const o = t.option || {};
        const bits = [];
        if (o.type) bits.push(o.type.charAt(0).toUpperCase() + o.type.slice(1));
        if (o.strike != null) bits.push("$" + o.strike);
        if (o.expiration) bits.push("exp " + o.expiration);
        if (o.contracts != null) bits.push(o.contracts + " contract" + (o.contracts === 1 ? "" : "s"));
        if (bits.length) return bits.join(" · ");
        return t.comment || "details not specified in filing";
      }

      function typeCell(t){
        const word = t.type === "sell" && t.partial ? "sell (partial)" : t.type;
        let s = `<span class="${t.type}">${esc(word)}</span>` +
          (t.owner ? `<span class="chip" title="spouse / joint / dependent child">${esc(t.owner)}</span>` : "");
        const opt = optionText(t);
        if (opt) s += `<div class="opt" title="${esc(t.comment || opt)}">🎟 ${esc(opt)}</div>`;
        return s;
      }

      function memberCell(t){
        const who = [t.party, t.district || t.state].filter(Boolean).join(" · ");
        const slug = PAGEMAPS.members[t.member];
        const name = slug
          ? `<a class="pagelink" href="/members/${slug}">${esc(t.member)}</a>`
          : esc(t.member);
        return `${name}${who ? `<span class="chip">${esc(who)}</span>` : ""}`;
      }

      function tickerCell(t){
        if (!t.ticker) return '<span class="muted">—</span>';
        const slug = PAGEMAPS.tickers[t.ticker];
        return slug
          ? `<a class="pagelink" href="/tickers/${slug}"><b>${esc(t.ticker)}</b></a>`
          : `<b>${esc(t.ticker)}</b>`;
      }

      function renderHead(){
        $("headRow").innerHTML = COLS.map(c => {
          const dir = state.sortKey === c.key ? `<span class="dir">${state.sortDir < 0 ? "▼" : "▲"}</span>` : "";
          return `<th data-k="${c.key}" ${c.nosort ? 'data-nosort="1"' : ""}>${c.label} ${dir}</th>`;
        }).join("");
      }

      function renderRows(){
        const rows = sorted(filtered());
        const slice = rows.slice(0, state.shown);
        $("rows").innerHTML = slice.map(t => `<tr>
          <td>${memberCell(t)}</td>
          <td>${tickerCell(t)}</td>
          <td>${esc(t.asset)}${t.asset_type ? `<span class="chip">${esc(t.asset_type)}</span>` : ""}</td>
          <td>${typeCell(t)}</td>
          <td class="num">${esc(t.amount_label)}</td>
          <td class="num">${retCell(t)}</td>
          <td class="num">${esc(t.tx_date)}</td>
          <td class="num">${esc(t.filing_date)}</td>
          <td><a href="${esc(t.source_url)}" target="_blank" rel="noopener" title="official filing">source ↗</a></td>
        </tr>`).join("");
        $("countLine").textContent =
          `${rows.length.toLocaleString("en-US")} trades` +
          (state.member ? ` — ${state.member} (click their card again to clear)` : "") +
          ` · showing ${Math.min(state.shown, rows.length).toLocaleString("en-US")}`;
        $("moreBtn").style.display = rows.length > state.shown ? "" : "none";
      }


      function cleanCompany(name){
        // Strip disclosure boilerplate from an asset name so it reads as a
        // company: trailing "$200?"-style fragments, then share-class suffixes
        // ("- Common Stock", "New Common Stock", "- Class A Common Stock",
        // "- Ordinary Shares").
        return name
          .replace(/\s*\$\S*\??\s*$/, "")
          .replace(/[-\s]*(new\s+)?(class\s+[a-z]\s+)?(common stock|ordinary shares|common shares)\s*$/i, "")
          .replace(/\s+/g, " ").replace(/[-\s]+$/, "").trim();
      }


      function notionalMid(t){
        // Estimated dollar size of one trade from its disclosed bracket. The
        // open-ended top bracket ($50,000,001 +) has no upper bound, so use its
        // floor. Everything here is an estimate — amounts are brackets, not exact.
        return t.amount_hi != null ? (t.amount_lo + t.amount_hi) / 2 : t.amount_lo;
      }

      function fmtMoney(n){
        if (n >= 1e6) return "$" + (n/1e6).toFixed(n >= 1e7 ? 0 : 1) + "M";
        if (n >= 1e3) return "$" + Math.round(n/1e3) + "k";
        return "$" + Math.round(n);
      }

      function tickerCompany(ticker){
        const names = {};
        for (const t of (DATA ? DATA.trades : []))
          if (t.ticker === ticker) names[t.asset] = (names[t.asset] || 0) + 1;
        const top = Object.entries(names).sort((a,b) => b[1] - a[1])[0];
        return top ? cleanCompany(top[0]) : "";
      }

      function tickerStats(ticker, sinceISO){
        const rows = (DATA ? DATA.trades : []).filter(t =>
          t.ticker === ticker && (!sinceISO || t.tx_date >= sinceISO));
        const buy = rows.filter(t => t.type === "buy");
        const sell = rows.filter(t => t.type === "sell");
        const exch = rows.filter(t => t.type === "exchange");
        return {
          rows, n: rows.length,
          buy: buy.length, sell: sell.length, exch: exch.length,
          members: new Set(rows.map(t => t.member)).size,
          buyEst: buy.reduce((s,t) => s + notionalMid(t), 0),
          sellEst: sell.reduce((s,t) => s + notionalMid(t), 0),
        };
      }


      // Display order for the featured universe; any ticker present in the data
      // but missing here is appended alphabetically by aiTickers().
      const AI_ORDER = ["NVDA","AMD","INTC","AVGO","MU","TSM","ASML","SNDK","MSFT",
                        "GOOGL","AMZN","META","TSLA","VRT","SMCI","DELL","YPF",
                        "MELI","NU","SPCX"];

      function fmtPrice(n){ return n == null ? "—" : "$" + Number(n).toFixed(2); }
      function fmtVol(n){
        if (n == null) return "—";
        if (n >= 1e9) return (n/1e9).toFixed(2) + "B";
        if (n >= 1e6) return (n/1e6).toFixed(1) + "M";
        if (n >= 1e3) return Math.round(n/1e3) + "k";
        return String(n);
      }
      function pctSpan(x){
        if (x == null) return '<span class="flat">—</span>';
        const cls = x > 0 ? "up" : x < 0 ? "down" : "flat";
        return `<span class="${cls}">${x > 0 ? "+" : ""}${Number(x).toFixed(2)}%</span>`;
      }
      function rsiZone(r){
        if (r == null) return "—";
        return r < 30 ? "oversold" : r > 70 ? "overbought" : "neutral";
      }
      function aiTickers(){ // ordered, only those we actually have data for
        const have = new Set(Object.keys(AI));
        return AI_ORDER.filter(t => have.has(t)).concat(
          [...have].filter(t => !AI_ORDER.includes(t)).sort());
      }
      function sigTags(sigs){
        return (sigs || []).map(s =>
          `<span class="sigtag ${esc(s.dir||"neutral")}" title="mechanical event on ${esc(s.asof)} — not advice">🔔 ${esc(s.label)}</span>`
        ).join("");
      }

      // Transparent mechanical scorecard: each indicator already shown on the page
      // casts a buy(+1)/hold(0)/sell(-1) vote; the votes sum to a headline read.
      // This is a rule-based tally, NOT investment advice — trend checks (price vs
      // the moving averages, 50d/200d alignment) dominate, with RSI (mean-reversion)
      // and short-term momentum as oscillators.
      function aiScore(a){
        const checks = [];
        const add = (label, vote, note) => checks.push({label, vote, note});
        const cmp = (x, y) => x > y ? 1 : x < y ? -1 : 0;
        if (a.price != null && a.sma20  != null) add("Price vs 20-day",  cmp(a.price, a.sma20),  `${fmtPrice(a.price)} vs ${fmtPrice(a.sma20)}`);
        if (a.price != null && a.sma50  != null) add("Price vs 50-day",  cmp(a.price, a.sma50),  `${fmtPrice(a.price)} vs ${fmtPrice(a.sma50)}`);
        if (a.price != null && a.sma200 != null) add("Price vs 200-day", cmp(a.price, a.sma200), `${fmtPrice(a.price)} vs ${fmtPrice(a.sma200)}`);
        if (a.sma50 != null && a.sma200 != null) add("50-day vs 200-day", cmp(a.sma50, a.sma200), a.sma50 >= a.sma200 ? "golden alignment" : "death alignment");
        if (a.rsi14 != null) add("RSI (14)", a.rsi14 < 30 ? 1 : a.rsi14 > 70 ? -1 : 0, `${a.rsi14} · ${rsiZone(a.rsi14)}`);
        if (a.chg_1m != null) add("1-month momentum", cmp(a.chg_1m, 0), `${a.chg_1m}%`);
        if (a.chg_1w != null) add("1-week momentum",  cmp(a.chg_1w, 0), `${a.chg_1w}%`);
        const buys  = checks.filter(c => c.vote > 0).length;
        const sells = checks.filter(c => c.vote < 0).length;
        const holds = checks.filter(c => c.vote === 0).length;
        const total = checks.length || 1;
        const ratio = (buys - sells) / total;
        let label, cls;
        if (ratio >= 0.5)        { label = "Strong Buy";  cls = "bull"; }
        else if (ratio >= 0.15)  { label = "Buy";         cls = "bull"; }
        else if (ratio <= -0.5)  { label = "Strong Sell"; cls = "bear"; }
        else if (ratio <= -0.15) { label = "Sell";        cls = "bear"; }
        else                     { label = "Hold";        cls = "neutral"; }
        return {label, cls, buys, sells, holds, checks, ratio};
      }

      function renderAiSignals(){
        // A short banner of the freshest signals across the universe (latest bar).
        const fired = aiTickers().flatMap(tk =>
          (AI[tk].signals || []).map(s => ({tk, ...s})));
        fired.sort((a,b) => a.asof < b.asof ? 1 : -1);
        $("aiSignals").innerHTML = fired.length
          ? `<span class="note">Latest signals:</span> ` + fired.slice(0, 8).map(s =>
              `<span class="sigtag ${esc(s.dir||"neutral")}" title="${esc(s.asof)}">🔔 ${esc(s.tk)} · ${esc(s.label)}</span>`).join("")
          : `<span class="note">No new signals on the latest session — indicators below are current.</span>`;
      }

      function renderAiCards(){
        $("aiCards").innerHTML = aiTickers().map(tk => {
          const a = AI[tk];
          const dot = (a.signals && a.signals.length) ? " 🔔" : "";
          const sc = aiScore(a);
          return `<div class="fcard ${state.aiTicker === tk ? "sel" : ""}" data-a="${esc(tk)}">
            <div class="name">${esc(tk)}${dot} <span class="scorepill ${sc.cls}" title="mechanical technical summary — not advice">${esc(sc.label)}</span></div>
            <div class="who">${esc(a.name || "")}</div>
            <div class="px">${fmtPrice(a.price)} <span style="font-size:12px">${pctSpan(a.chg_1d)}</span></div>
            <div class="metarow">
              <span class="rsibadge">RSI ${a.rsi14 == null ? "—" : Math.round(a.rsi14)} · ${esc(rsiZone(a.rsi14))}</span>
              <span class="note">${a.sma50 != null && a.sma200 != null
                ? (a.sma50 >= a.sma200 ? '<span class="up">50d›200d</span>' : '<span class="down">50d‹200d</span>')
                : ""}</span>
            </div>
          </div>`;
        }).join("");
      }

      function aiPrompts(tk, a){
        const asof = a.asof_date || "latest close";
        const sc = aiScore(a);
        const p1 =
      `Analyze the current trends in the stock market, focusing on ${a.name} ($${tk}). `
      + `Identify any emerging patterns and suggest possible investment opportunities. `
      + `Take into account the latest earnings reports and sector news in your analysis.\n\n`
      + `For reference — $${tk} daily close as of ${asof}: price ${fmtPrice(a.price)}, `
      + `1-week ${a.chg_1w ?? "—"}%, 1-month ${a.chg_1m ?? "—"}%, RSI(14) ${a.rsi14 ?? "—"}, `
      + `50-day avg ${fmtPrice(a.sma50)}, 200-day avg ${fmtPrice(a.sma200)}, `
      + `volume ${fmtVol(a.volume)} vs 20-day avg ${fmtVol(a.avg_vol_20)}.`;
        const p2 =
      `Using technical analysis, evaluate the stock of ${a.name} ($${tk}). `
      + `Analyze recent price movements, volume, and key indicators such as moving averages `
      + `and the RSI. Provide a recommendation to buy, sell, or hold.\n\n`
      + `Current readings ($${tk}, daily close ${asof}): price ${fmtPrice(a.price)}, `
      + `1-day ${a.chg_1d ?? "—"}%, RSI(14) ${a.rsi14 ?? "—"}, SMA20 ${fmtPrice(a.sma20)}, `
      + `SMA50 ${fmtPrice(a.sma50)}, SMA200 ${fmtPrice(a.sma200)}, `
      + `52-week range ${fmtPrice(a.low_52w)}–${fmtPrice(a.high_52w)}, `
      + `volume ${fmtVol(a.volume)} vs 20-day avg ${fmtVol(a.avg_vol_20)}. `
      + `A simple mechanical tally of these indicators reads "${sc.label}" (${sc.buys} buy / ${sc.holds} hold / ${sc.sells} sell) — `
      + `weigh it against fundamentals and news before concluding.`;
        return [
          {title:"📈 Market-trend & opportunities prompt", text:p1},
          {title:"📊 Technical-analysis prompt (buy / sell / hold)", text:p2},
        ];
      }

      function renderAiDetail(){
        const box = $("aiDetail");
        const tk = state.aiTicker;
        const a = AI[tk];
        if (!a){
          box.innerHTML = `<div class="note">No indicator data for ${esc(tk || "—")}.
            The AI tab covers: ${aiTickers().join(", ") || "(pending first refresh)"}.</div>`;
          return;
        }
        const rp = a.range_pos == null ? null : Math.max(0, Math.min(100, a.range_pos));
        // Congressional angle — ties this ticker back to the tracker's actual data.
        const s = (typeof tickerStats === "function") ? tickerStats(tk, "") : {n:0};
        const congress = s.n
          ? `<div class="note" style="margin-top:6px">🏛 <b>Congress:</b> ${s.n} disclosed trade${s.n===1?"":"s"} all-time
              (<span class="buy">${s.buy} buy</span> · <span class="sell">${s.sell} sell</span>), ${s.members} member${s.members===1?"":"s"}.
              ${PAGEMAPS.tickers[tk]
                  ? `<a href="/tickers/${PAGEMAPS.tickers[tk]}">See who traded it →</a>`
                  : ""}</div>`
          : `<div class="note" style="margin-top:6px">🏛 No congressional trades on record for $${esc(tk)}.</div>`;

        const cell = (k, v, x) =>
          `<div class="indcell"><div class="k">${k}</div><div class="v">${v}</div>${x?`<div class="x">${x}</div>`:""}</div>`;

        const sc = aiScore(a);
        const voteWord = v => v > 0 ? "buy" : v < 0 ? "sell" : "hold";
        const voteCls  = v => v > 0 ? "up"  : v < 0 ? "down" : "flat";
        const scoreHtml = `<div class="scorecard ${sc.cls}">
            <div class="scorehead">
              <div>
                <div class="scorelabel">${esc(sc.label)}</div>
                <div class="note">mechanical technical summary — <b>not investment advice</b></div>
              </div>
              <div class="scoretally">
                <span class="up">${sc.buys} buy</span> ·
                <span class="flat">${sc.holds} hold</span> ·
                <span class="down">${sc.sells} sell</span>
                <div class="note">across ${sc.checks.length} indicator checks</div>
              </div>
            </div>
            <details class="scorewhy"><summary>How this is computed</summary>
              <div class="scorechecks">${sc.checks.map(c =>
                `<div class="scr"><span class="${voteCls(c.vote)}">${voteWord(c.vote).toUpperCase()}</span>
                  <span class="scrk">${esc(c.label)}</span>
                  <span class="note">${esc(c.note)}</span></div>`).join("")}</div>
              <div class="note" style="margin-top:6px">A plain rule-based tally of the indicators shown below — trend checks
                (price vs each moving average, 50d/200d alignment), RSI (oversold = buy, overbought = sell) and momentum each cast
                one vote. It is <b>not</b> a recommendation and ignores fundamentals, news and your own risk/goals.</div>
            </details>
          </div>`;

        box.innerHTML =
          `<h3>${esc(tk)} <span class="note">${esc(a.name||"")}</span></h3>
           <div class="tksummary">
             <span><b>${fmtPrice(a.price)}</b> ${pctSpan(a.chg_1d)} <span class="est">daily close · as of ${esc(a.asof_date||"—")}</span></span>
           </div>
           ${scoreHtml}
           ${a.signals && a.signals.length ? `<div style="margin:2px 0 8px">${sigTags(a.signals)}</div>` : ""}
           <div class="indgrid">
             ${cell("Change 1d / 1w / 1m", `${pctSpan(a.chg_1d)} / ${pctSpan(a.chg_1w)} / ${pctSpan(a.chg_1m)}`)}
             ${cell("RSI (14)", a.rsi14 == null ? "—" : a.rsi14, rsiZone(a.rsi14))}
             ${cell("Trend (50d vs 200d)", a.sma50 != null && a.sma200 != null
                ? (a.sma50 >= a.sma200 ? '<span class="up">uptrend</span>' : '<span class="down">downtrend</span>') : "—",
                a.sma50 != null && a.sma200 != null ? `50d ${fmtPrice(a.sma50)} · 200d ${fmtPrice(a.sma200)}` : "")}
             ${cell("Price vs 50-day", a.vs_sma50 == null ? "—" : pctSpan(a.vs_sma50))}
             ${cell("Price vs 200-day", a.vs_sma200 == null ? "—" : pctSpan(a.vs_sma200))}
             ${cell("SMA 20", fmtPrice(a.sma20))}
             ${cell("Volume vs 20d avg", a.rel_vol == null ? "—" : a.rel_vol + "×", `${fmtVol(a.volume)} vs ${fmtVol(a.avg_vol_20)}`)}
             ${cell("52-week range", `${fmtPrice(a.low_52w)} – ${fmtPrice(a.high_52w)}`,
                rp == null ? "" : `${Math.round(rp)}% of range` +
                `<div class="rngbar"><div class="dot" style="left:${rp}%"></div></div>`)}
           </div>
           ${congress}
           <div class="legend" style="margin-top:10px">
             The summary above is a <b>mechanical tally</b> of these readings, not a recommendation and blind to fundamentals,
             news and your own goals. For a reasoned buy/sell/hold with those factors, copy a prompt below (already filled with
             today's numbers — and this mechanical read) into your AI assistant.
           </div>
           ${aiPrompts(tk, a).map((p, i) => `<div class="promptcard">
              <h4>${p.title}</h4>
              <textarea class="promptbox" id="prompt${i}" readonly>${esc(p.text)}</textarea>
              <button class="act copybtn" data-copy="prompt${i}">📋 Copy prompt</button>
            </div>`).join("")}`;
      }


      // ── Slug for linking a ticker to its own static page ───────────────
      const tickerSlug = tk => String(tk).toLowerCase().replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");

      function renderAi(){
        renderAiSignals();
        renderAiCards();
        renderAiDetail();
      }

      function renderAll(){
        renderHead();
        renderRows();
        renderAi();
      }

      // ── Wiring ─────────────────────────────────────────────────────────
      function wire(){
        $("tabs").addEventListener("click", e => {
          const tab = e.target.closest(".tab:not(.tab-link)");
          if (!tab) return;
          document.querySelectorAll("#tabs .tab").forEach(t => {
            if (t.classList.contains("tab-link")) return;
            const on = t === tab;
            t.classList.toggle("active", on);
            t.setAttribute("aria-selected", on ? "true" : "false");
          });
          document.querySelectorAll(".panel").forEach(p => {
            const on = p.id === tab.dataset.p;
            p.classList.toggle("active", on);
            p.hidden = !on;
          });
        });

        const rerender = () => { state.shown = PAGE; renderRows(); };
        $("q").addEventListener("input", e => { state.q = e.target.value; rerender(); });
        $("fChamber").addEventListener("change", e => { state.chamber = e.target.value; rerender(); });
        $("fParty").addEventListener("change", e => { state.party = e.target.value; rerender(); });
        $("fType").addEventListener("change", e => { state.type = e.target.value; rerender(); });
        $("fRange").addEventListener("change", e => { state.range = e.target.value; rerender(); });
        $("fAsset").addEventListener("change", e => { state.asset = e.target.value; rerender(); });
        $("clearBtn").addEventListener("click", () => {
          // Back to the DEFAULT view — which is stocks/options, not "all".
          state = {...state, q:"", chamber:"", party:"", type:"", range:"", member:"", asset:"equity", shown:PAGE};
          $("q").value = ""; $("fChamber").value = ""; $("fParty").value = "";
          $("fType").value = ""; $("fRange").value = ""; $("fAsset").value = "equity";
          renderRows();
        });
        $("moreBtn").addEventListener("click", () => { state.shown += PAGE; renderRows(); });

        $("headRow").addEventListener("click", e => {
          const th = e.target.closest("th");
          if (!th || th.dataset.nosort) return;
          const k = th.dataset.k;
          if (state.sortKey === k) state.sortDir *= -1;
          else { state.sortKey = k; state.sortDir = -1; }
          state.shown = PAGE;
          renderHead(); renderRows();
        });

        $("aiCards").addEventListener("click", e => {
          const card = e.target.closest(".fcard");
          if (!card) return;
          state.aiTicker = card.dataset.a;
          renderAi();
        });
        $("aiq").addEventListener("input", e => {
          const v = e.target.value.trim().toUpperCase();
          if (v) { state.aiTicker = v; renderAi(); }
        });
        $("aiClearBtn").addEventListener("click", () => {
          $("aiq").value = ""; state.aiTicker = "NVDA"; renderAi();
        });
        $("aiDetail").addEventListener("click", e => {
          const btn = e.target.closest(".copybtn");
          if (btn){
            const ta = $(btn.dataset.copy);
            if (ta){
              navigator.clipboard?.writeText(ta.value);
              btn.textContent = "✓ Copied";
              setTimeout(() => { btn.textContent = "📋 Copy prompt"; }, 1600);
            }
          }
        });
      }

      // ── Boot ───────────────────────────────────────────────────────────
      // Each feed loads independently: the trade table must render even if the
      // prices or indicators file is missing, and vice versa.
      fetch("/data/congress-trades.json", {cache:"no-store"})
        .then(r => r.json())
        .then(d => {
          DATA = d;
          renderHead();
          renderRows();
          if (Object.keys(AI).length) renderAiDetail();
        })
        .catch(() => {
          $("countLine").textContent =
            "Could not load the disclosure data. Please refresh.";
        });

      fetch("/data/returns.json", {cache:"no-store"})
        .then(r => r.json())
        .then(d => {
          RET = d.returns || {};
          PRICES = d.prices || {};
          retSample = !!(d.meta && d.meta.sample);
          $("retLegend").innerHTML =
            "“Since buy” is the stock's % change since the disclosed trade date — an "
            + "estimate from daily closes, <b>not</b> the member's realised profit "
            + "(holding period, sells, dividends and position size are unknown)."
            + (retSample ? " <b>Sample data</b> until the first live price refresh." : "");
          if (DATA) renderRows();
        })
        .catch(() => {});

      fetch("/data/ai-indicators.json", {cache:"no-store"})
        .then(r => r.json())
        .then(d => {
          AI = d.tickers || {};
          AI_META = d.meta || {};
          aiSample = !!AI_META.sample;
          if (aiSample) $("aiSampleBanner").style.display = "";
          renderAi();
        })
        .catch(() => {
          $("aiDetail").innerHTML =
            '<div class="note">Indicator data is unavailable right now.</div>';
        });

      wire();
    </script>
  </body>
</html>

<style is:global>
  /* The tracker is the one page with JS-injected markup, so its rules must be
     GLOBAL — Astro's scoped styles only tag elements that exist at build time,
     and every table row and card here is created at runtime. Everything is
     nested under .tracker so nothing leaks to the rest of the site.
     Design system per DESIGN.md: zero radius, hairline rules, mono for data. */

  .tracker {
    font-family: var(--font-mono);
    font-size: 0.83rem;
    color: var(--color-ink);
  }

  /* ── Tabs ─────────────────────────────────────────────────────── */
