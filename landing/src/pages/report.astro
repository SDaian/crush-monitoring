---
// "/report" — the web edition of the morning email. One always-current URL
// (not a dated archive: nobody searches "morning report July 24", and 365
// near-duplicate pages a year would be an SEO liability).
//
// It renders landing/src/data/report.json, which congress/daily_report.py
// writes from the SAME structure it builds the email from — so the page and
// the email can never disagree. The one deliberate difference: the email caps
// disclosures at MAX_DISCLOSURES because mail clients clip long messages,
// while this page carries every disclosure in the window. That is what the
// email's "…and N more" links to.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import SignupForm from "../components/SignupForm.astro";
import SignupModal from "../components/SignupModal.astro";
import ReportBody from "../components/ReportBody.astro";
import report from "../data/report.json";
import { plural, seoDescription } from "../lib/seo";

const r = report as any;
const c = r.counts ?? {};

const title = "Congress stock trades today — the morning report · Capitol Ledger";
const description = seoDescription(
  "Today's newly filed congressional trades, plus a mechanical technical " +
    `read on ${plural(c.tickers ?? 0, "featured stock")}.`,
  "The web edition of the daily Capitol Ledger email.",
);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Capitol Ledger morning report",
    description,
    dateModified: r.date,
    isAccessibleForFree: true,
  },
];
---

<html lang="en">
  <head>
    <Seo title={title} description={description} path="/report" schema={schema} />
  </head>
  <body>
    <Header />

    <section class="mx-auto max-w-[75rem] px-[5vw] pt-[9vh] pb-[5vh]">
      <p class="eyebrow mb-5">
        Morning report · <b class="font-semibold text-stamp">{r.dateLabel}</b>
      </p>
      <h1 class="headline max-w-[18ch] text-[clamp(2.2rem,5.5vw,4rem)]">
        Today in <span class="underline-stamp">Congress</span>.
      </h1>
      <p class="mt-6 max-w-[60ch] text-[1.05rem] leading-[1.65] text-pretty text-ink-soft">
        {c.disclosures ?? 0} newly filed disclosure{c.disclosures === 1 ? "" : "s"},
        {" "}{c.new_signals ?? 0} overnight signal{c.new_signals === 1 ? "" : "s"} and
        {" "}{c.flips ?? 0} rating change{c.flips === 1 ? "" : "s"}. This is the same
        report that goes out by email each morning — mechanical readings from
        past daily closes and official STOCK Act filings.
        <b class="text-ink"> Not investment advice.</b>
      </p>
      <!-- Stays a LINK, not a second form: the real one is in the closing
           band below, and DESIGN.md §10 allows one primary action per view. -->
      <p class="mt-5">
        <a href="#join" class="btn inline-block no-underline">Get it by email</a>
      </p>
      <p class="mono mt-4 text-[.75rem] uppercase tracking-[.06em]">
        <a href="/report/archive" class="text-stamp no-underline hover:text-ink"
          >Past reports →</a
        >
      </p>
    </section>

    <ReportBody r={r} />

    <section class="border-t-2 border-ink px-[5vw] py-[10vh] text-center">
      <h2 class="text-[clamp(1.8rem,4.5vw,3.2rem)] font-black leading-[1.15] tracking-[-0.03em] text-balance">
        Get this in your inbox at 9am.
      </h2>
      <p class="mx-auto mt-4 mb-6 max-w-[46ch] text-pretty text-ink-soft">
        This exact report, in your inbox each morning — every new disclosure
        and every overnight signal, once a day.
      </p>
      <SignupForm variant="band" id="join" />
    </section>

    <Footer />

    <SignupModal title="Get this report at 9am." />
  </body>
</html>
