---
// "/members" — index of the featured filers, each linking to their own page.
// Internal-linking hub for the /members/<slug> set and its own landing target.
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Seo from "../../components/Seo.astro";
import SignupForm from "../../components/SignupForm.astro";
import SignupModal from "../../components/SignupModal.astro";
import index from "../../data/members/_index.json";
import { plural, seoDescription } from "../../lib/seo";

const members = index.members;
const partyName: Record<string, string> = {
  D: "Democrat",
  R: "Republican",
  I: "Independent",
};

const title = "Featured filers — politician stock-trade pages · Capitol Ledger";
const description = seoDescription(
  `${plural(members.length, "featured filer")}, one page each: every stock ` +
    "trade they disclosed, their estimated holdings and their filing delays.",
  "From official records.",
);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Featured filers",
    description,
    hasPart: members.map((m: any) => ({
      "@type": "ProfilePage",
      name: `${m.name} stock trades`,
      url: `https://capitolledger.io/members/${m.slug}`,
    })),
  },
];
---

<html lang="en">
  <head>
    <Seo title={title} description={description} path="/members" schema={schema} />
  </head>
  <body>
    <Header active="members" />

    <section class="mx-auto max-w-[75rem] px-[5vw] pt-[9vh] pb-[6vh]">
      <p class="eyebrow mb-5">
        Featured filers · <b class="font-semibold text-stamp">Most-watched</b>
      </p>
      <h1 class="headline max-w-[18ch] text-[clamp(2.4rem,6.5vw,4.6rem)]">
        The traders <span class="underline-stamp">worth watching</span>.
      </h1>
      <p class="mt-6 max-w-[56ch] text-[1.05rem] leading-[1.65] text-pretty text-ink-soft">
        A page for each of the filers people ask about most — every trade
        they've disclosed, an estimate of what they hold, and how late each
        filing arrived. Straight from official records.
      </p>
    </section>

    <section class="mx-auto max-w-[75rem] px-[5vw] pb-[10vh]">
      <div class="grid grid-cols-2 gap-x-10 gap-y-1 max-[720px]:grid-cols-1">
        {
          members.map((m: any) => (
            <a href={`/members/${m.slug}`} class="mcard">
              <div class="mcard-namerow">
                <div class="mcard-name">{m.name}</div>
                {m.perfPct != null && m.perfBenchPct != null && (
                  <span class="mcard-badge">
                    <b class:list={[m.perfPct >= m.perfBenchPct ? "perf-lead" : ""]}>
                      {m.perfPct >= 0 ? "📈" : "📉"} {m.perfPct >= 0 ? "+" : "−"}{Math.abs(m.perfPct)}%
                    </b>
                    <small>S&P {m.perfBenchPct >= 0 ? "+" : "−"}{Math.abs(m.perfBenchPct)}%</small>
                  </span>
                )}
              </div>
              <div class="mcard-meta">
                {partyName[m.party] ?? m.party} · {m.state} ·{" "}
                {m.chamber}
              </div>
              <div class="mcard-stat">
                <b>{m.trades.toLocaleString("en-US")}</b> trades ·{" "}
                <b>
                  {m.pctLate === 0 && m.worstLate > 0 ? "<1%" : `${m.pctLate}%`}
                </b>{" "}
                filed late
                <span class="mcard-go">View trades →</span>
              </div>

            </a>
          ))
        }
      </div>
      <p class="fineprint mt-8 max-w-[85ch]">
        "Buys" is the estimated price change of each member's disclosed stock
        buys, equal-weighted and held, against the same dollars on the same
        dates in the S&P 500 — <b class="text-ink">not realized profit</b>
        (fills, sells and position sizes are unknown). Full methodology on
        each member's page.
      </p>
    </section>

    <section class="border-t-2 border-ink px-[5vw] py-[10vh] text-center">
      <h2 class="text-[clamp(1.8rem,4.5vw,3.2rem)] font-black leading-[1.15] tracking-[-0.03em] text-balance">
        Follow every filer at once.
      </h2>
      <p class="mx-auto mt-4 mb-6 max-w-[46ch] text-pretty text-ink-soft">
        Every new disclosure — from these members and everyone else — in one
        morning email.
      </p>
      <SignupForm variant="band" id="join" />
    </section>

    <Footer />

    <SignupModal />
  </body>
</html>

<style>
  .mcard {
    display: block;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: var(--color-ink);
  }
  .mcard:hover .mcard-name,
  .mcard:focus-visible .mcard-name {
    color: var(--color-stamp);
  }
  .mcard-name {
    font-weight: 900;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    letter-spacing: -0.02em;
    transition: color 0.15s;
  }
  .mcard-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-soft);
    margin-top: 0.5rem;
  }
  .mcard-stat {
    font-family: var(--font-mono);
    font-size: 0.83rem;
    color: var(--color-ink-soft);
    margin-top: 0.75rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }
  .mcard-stat b {
    color: var(--color-ink);
    font-weight: 600;
  }
  .mcard-namerow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  /* The performance badge: the buys total up front (chart-direction emoji =
     gained or lost), the S&P over the same windows always directly beneath —
     the member's number never travels without its yardstick. Stamp only when
     actually ahead of the index. */
  .mcard-badge {
    text-align: right;
    font-family: var(--font-mono);
    line-height: 1.25;
  }
  .mcard-badge b {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .mcard-badge b.perf-lead {
    color: var(--color-stamp);
  }
  .mcard-badge small {
    display: block;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }
  .mcard-go {
    margin-left: auto;
    color: var(--color-stamp);
    font-weight: 600;
  }
</style>
