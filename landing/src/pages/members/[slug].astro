---
// "/members/<slug>" — one page per featured filer: their disclosed trades,
// estimated holdings, most-traded tickers and filing timeliness, all from the
// daily pipeline (landing/src/data/members/*.json). Built as static pages for
// the featured set only; scaling to every member is the storage-stage-1
// trigger in ROADMAP.md. Same editorial system as the rest of the site.
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Seo from "../../components/Seo.astro";
import SignupForm from "../../components/SignupForm.astro";
import SignupModal from "../../components/SignupModal.astro";
import CountUp from "../../components/CountUp.astro";
import HoldingsChart from "../../components/HoldingsChart.astro";
import PerformanceChart from "../../components/PerformanceChart.astro";
import StarButton from "../../components/StarButton.astro";
import { plural, seoDescription } from "../../lib/seo";

// Build-time "checked" date: when this page was last regenerated. Deliberately
// computed here, not stamped into the data files — a timestamp in the payload
// would make every generated JSON diff daily even when nothing changed.
const checkedOn = new Date().toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});


export async function getStaticPaths() {
  const all = import.meta.glob("../../data/members/*.json", { eager: true });
  return Object.entries(all)
    .filter(([path]) => !path.endsWith("/_index.json"))
    .map(([, mod]) => {
      const m = (mod as { default: any }).default;
      return { params: { slug: m.slug }, props: { m } };
    });
}

const { m } = Astro.props as { m: any };
const s = m.summary;

const partyName = { D: "Democrat", R: "Republican", I: "Independent" }[
  m.party as string
] ?? m.party;
// Seat line: senators by state, House members by district, executive-branch
// filers (President etc.) don't have a district — show the branch instead.
const seat =
  m.chamber === "Executive"
    ? `${partyName} · Executive branch`
    : m.chamber === "Senate"
      ? `${partyName} · ${m.state}`
      : `${partyName} · ${m.district ?? m.state}`;
const jobTitle =
  m.chamber === "Executive"
    ? "U.S. executive-branch official"
    : m.chamber === "Senate"
      ? "U.S. Senator"
      : "Member of Congress";
const affiliation =
  m.chamber === "Executive"
    ? "U.S. executive branch"
    : "United States Congress";

const fmtDate = (iso: string | null) =>
  iso
    ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
      })
    : "—";
const fmtMonth = (iso: string | null) =>
  iso
    ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      })
    : "—";

// "<1%" when a late filing exists but rounds to 0 — never "0%" beside a
// non-zero worst delay (that reads as a contradiction).
const pctLateLabel =
  s.pctLate === 0 && s.worstLate > 0 ? "<1%" : `${s.pctLate}%`;
// Bars are scaled to the biggest holding, not to 100%, so a diversified
// portfolio still shows a readable shape instead of sixteen slivers.
const heldPcts: number[] = (m.holdings?.ranked ?? []).map(
  (h: any) => h.pctPortfolio ?? 0,
);
const maxPct = Math.max(...heldPcts, 1);
// What the 16 listed rows leave out. pctPortfolio is a share of the FULL
// estimated portfolio, so the shortfall is the untracked tail. The ranked
// list holds stocks AND options, so both the percentage and the count come
// off the same list — an earlier split, where options sat outside it, let
// the tail absorb their share without naming it.
const restPct = Math.max(0, 100 - heldPcts.reduce((a, b) => a + b, 0));
const untracked = Math.max(
  0,
  (m.holdings?.positionsTotal ?? 0) - heldPcts.length,
);
// Clamped at both ends: a sliver still reads as a bar, and the untracked
// tail (which can far exceed the largest listed holding) stops at full width
// instead of running off the page.
const barWidth = (pct: number) =>
  Math.min(100, Math.max(2, (pct / maxPct) * 100));

// The Assets filter renders only when the record holds both classes: a
// select with one meaningful option is noise (Pelosi has no bonds).
const hasBonds = m.trades.some((t: any) => t.bond);
const hasEquities = m.trades.some((t: any) => !t.bond);

const STAT_CARDS = [
  { n: s.trades.toLocaleString("en-US"), l: "trades disclosed" },
  { n: s.distinctTickers.toLocaleString("en-US"), l: "distinct tickers" },
  { n: pctLateLabel, l: "filed late" },
  {
    n: s.worstLate ? s.worstLate.toLocaleString("en-US") : "0",
    l: s.worstLate ? "days · worst delay" : "days late · worst",
  },
];

const title = `${m.name} stock trades — every disclosed trade · Capitol Ledger`;
// Lead with the name and the counts; the party/state gloss is the droppable
// tail, since a long name would otherwise push the numbers out of view.
// Executive-branch filers disclose managed-account bonds that carry no ticker,
// so the spread clause has to disappear rather than read "across 0 tickers".
const hasTickers = s.distinctTickers > 0;
const description = seoDescription(
  `${m.name} has disclosed ` +
    plural(s.trades, hasTickers ? "stock trade" : "trade") +
    (hasTickers ? ` across ${plural(s.distinctTickers, "ticker")}` : "") +
    " — the amounts, the dates and how late each filing arrived.",
  `${partyName}, ${m.state}.`,
);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    dateModified: s.lastFiling ?? s.lastTx ?? undefined,
    mainEntity: {
      "@type": "Person",
      name: m.name,
      jobTitle,
      affiliation: { "@type": "Organization", name: affiliation },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `${m.name} — disclosed stock trades`,
    description,
    creator: { "@type": "Organization", name: "Capitol Ledger" },
    isAccessibleForFree: true,
    license: "https://www.usa.gov/government-works",
    temporalCoverage:
      s.firstTx && s.lastTx ? `${s.firstTx}/${s.lastTx}` : undefined,
  },
];
---

<html lang="en">
  <head>
    <Seo
      title={title}
      description={description}
      path={`/members/${m.slug}`}
      schema={schema}
    />
  </head>
  <body>
    <Header active="members" />

    <main id="content">
    <section class="mx-auto max-w-[75rem] px-[5vw] pt-[9vh] pb-[6vh]">
      {/* Section-head style split: who they are (label · party · seat) on
           the left, the newest-filing date on the right — the data's own
           freshness is the header's right-hand meta. */}
      <p class="eyebrow mb-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <span>Featured filer · <b class="font-semibold text-stamp">{seat}</b></span>
        {s.lastFiling && (
          <span>Newest filing <b class="font-semibold text-ink">{fmtDate(s.lastFiling)}</b></span>
        )}
      </p>
      <h1 class="headline max-w-[16ch] text-[clamp(2.4rem,6.5vw,4.6rem)]">
        {m.name}'s <span class="underline-stamp">stock trades</span>.
      </h1>
      <p class="mt-6 max-w-[58ch] text-[1.05rem] leading-[1.65] text-pretty text-ink-soft">
        Every trade {m.name} has disclosed under the STOCK Act — {s.trades.toLocaleString("en-US")}
        {" "}across {s.distinctTickers} tickers, from {fmtMonth(s.firstTx)} to
        {" "}{fmtMonth(s.lastTx)}. Amounts are the brackets as filed; timing is
        counted against the 45-day legal maximum.
      </p>
      {/* "Checked" (when WE rebuilt the page) stays down here; "newest
           filing" (how recent THEIR data is) lives in the header's right
           meta. Keeping the two apart stops 30-45-day-old trades from
           dressing up as current. */}
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        <StarButton
          kind="members"
          id={m.slug}
          name={m.name.split(" ").slice(-1)[0]}
        />
        <p class="mono text-[.75rem] uppercase tracking-[.08em] text-ink-soft">
          Checked {checkedOn}
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-[75rem] px-[5vw] pb-[7vh]">
      <div class="statstrip">
        {
          STAT_CARDS.map((c) => (
            <div class="stat">
              <div class="statnum stat-n">{c.n}</div>
              <div class="statlabel">{c.l}</div>
            </div>
          ))
        }
      </div>
    </section>

    {
      m.committees && (
        <section class="mx-auto max-w-[75rem] px-[5vw] pb-[7vh]">
          <div class="section-head">
            <h2 class="section-title whitespace-nowrap">Committee seats</h2>
            <span class="eyebrow">Current assignments</span>
          </div>
          <div class="mt-8 grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(min(19rem,100%),1fr))]">
            {m.committees.committees.map((c: any) => (
              <div class="cmte">
                <div class="cmte-name">
                  {c.url ? (
                    <a href={c.url} rel="nofollow noopener">{c.name}</a>
                  ) : (
                    c.name
                  )}
                  {c.title && <span class="cmte-role">{c.title}</span>}
                </div>
                {c.subcommittees.length > 0 && (
                  <ul class="cmte-subs">
                    {c.subcommittees.map((sub: string) => <li>{sub}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
          {m.committees.overlap && (
            <div class="ovl">
              <h3 class="ovl-head">
                Disclosed trades in an industry these seats oversee
              </h3>
              {m.committees.overlap.map((r: any) => (
                <div class="ovl-row">
                  <div class="ovl-label">
                    {r.label}
                    <span class="ovl-count">
                      {r.trades} {r.trades === 1 ? "trade" : "trades"} ·{" "}
                      {r.symbols} {r.symbols === 1 ? "symbol" : "symbols"}
                    </span>
                  </div>
                  <div class="ovl-seats">{r.committees.join(" · ")}</div>
                  <div class="ovl-tix">
                    {r.tickers.map((t: any) => (
                      <span class="ovl-tk">
                        <b>{t.ticker}</b>
                        <span>{t.count}×</span>
                      </span>
                    ))}
                    {r.more > 0 && <span class="ovl-more">+{r.more} more</span>}
                  </div>
                </div>
              ))}
            </div>
          )}
          <p class="fineprint mt-7 max-w-[80ch]">
            Seats as listed by the official House and Senate committee rosters.
            We publish where a member sits, and what they disclosed. We draw no
            line between the two, and neither should a reader without more
            evidence.
            {m.committees.coverage && (
              <>
                {" "}The industry grouping is ours, not an official
                classification: we map a committee to the industries it
                legislates on, and a symbol to one industry. It covers{" "}
                <b class="text-ink">
                  {m.committees.coverage.classified} of the{" "}
                  {m.committees.coverage.total}
                </b>{" "}
                symbols {m.name.split(" ").slice(-1)[0]} disclosed, so a symbol
                missing from a row may be unclassified rather than outside the
                industry.
              </>
            )}
          </p>
        </section>
      )
    }

    {
      m.topTickers.length > 0 && (
        <section class="mx-auto max-w-[75rem] px-[5vw] pb-[7vh]">
          <div class="section-head">
            <h2 class="section-title">Most-traded tickers</h2>
            <span class="eyebrow">By number of disclosed trades</span>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            {m.topTickers.map((t: any) =>
              t.hasPage ? (
                <a href={`/tickers/${t.slug}`} class="chip chip-link">
                  <b>{t.ticker}</b>
                  <span>{t.count}×</span>
                </a>
              ) : (
                <div class="chip">
                  <b>{t.ticker}</b>
                  <span>{t.count}×</span>
                </div>
              ),
            )}
          </div>
        </section>
      )
    }

    {
      m.holdings.available && m.holdings.ranked.length > 0 && (
        <section class="mx-auto max-w-[75rem] px-[5vw] pb-[7vh]">
          <div class="section-head">
            <h2 class="section-title whitespace-nowrap">Estimated holdings</h2>
            <span class="eyebrow">
              ~<b class="font-semibold text-stamp">{m.holdings.totalLabel}</b> ·
              {" "}{m.holdings.positions + (m.holdings.optionsCount ?? 0)} positions
            </span>
          </div>
          <p class="fineprint mt-4 max-w-[85ch]">
            {m.name}'s {m.holdings.reportYear} annual disclosure, <b class="text-ink"
              >rolled forward</b
            > with {m.holdings.filingsSince}
            {" "}filing{m.holdings.filingsSince === 1 ? "" : "s"} since — so
            recent buys and sells nudge the year-end snapshot toward today.
            Bracket midpoints, <b>not</b> share counts; the percentage is each
            position's share of the estimated total, options included. A
            directional estimate, never exact or real-time.
          </p>
          <HoldingsChart
            holdings={m.holdings.ranked}
            positions={m.holdings.positionsTotal ?? m.holdings.positions}
            totalLabel={m.holdings.totalLabel}
            name={m.name}
          />

          <div class="mt-9 grid grid-cols-2 gap-x-12 gap-y-1 max-[720px]:grid-cols-1">
            {m.holdings.ranked.map((h: any) => (
              <div class="hrow">
                <span class="htick">{h.ticker}</span>
                <span class="hname">
                  {/* An option row names its CONTRACT, not just the company:
                      a member can hold the stock and a call on one ticker,
                      and two rows reading "Bloom Energy" tell them apart by
                      nothing. Terms first so truncation eats the company
                      name, which the ticker cell already gives. */}
                  <span>
                    {h.kind === "option"
                      ? `$${h.strike} ${h.optType ?? "call"}` +
                        (h.expiration ? ` · exp ${fmtMonth(h.expiration)}` : "")
                      : h.asset}
                  </span>
                  {h.isNew && <b class="hnew">new</b>}
                </span>
                {/* The bar IS the row — scaled to the largest holding so the
                    shape is readable even when every share is small. */}
                <span class="hbar" aria-hidden="true">
                  <i style={`width:${barWidth(h.pctPortfolio ?? 0)}%`} />
                </span>
                <span class="hval">~{h.estLabel}</span>
                {h.pctPortfolio != null && (
                  <span class="hpct">{h.pctPortfolio}%</span>
                )}
              </div>
            ))}
            {/* Without this the list silently reads as the whole portfolio;
                for Greene the 16 shown are only 40% of it. */}
            {untracked > 0 && (
              <div class="hrow is-rest">
                <span class="htick">···</span>
                <span class="hname">
                  {untracked} smaller position{untracked === 1 ? "" : "s"} not
                  listed
                </span>
                <span class="hbar" aria-hidden="true">
                  <i style={`width:${barWidth(restPct)}%`} />
                </span>
                <span class="hval">—</span>
                <span class="hpct">{Number(restPct.toFixed(1))}%</span>
              </div>
            )}
          </div>

          {
            m.holdings.options.length > 0 && (
              <>
                <div class="mono mt-8 mb-3 text-[.75rem] uppercase tracking-[.07em] text-ink-soft">
                  Live options
                </div>
                <div class="flex flex-wrap gap-x-8 gap-y-2">
                  {m.holdings.options.map((o: any) => (
                    <div class="orow">
                      <b>{o.ticker}</b>
                      <span>
                        {o.type ?? "option"}
                        {o.strike != null ? ` $${o.strike}` : ""}
                        {o.expiration ? ` · exp ${fmtMonth(o.expiration)}` : ""}
                        {o.contracts
                          ? ` · ${o.contracts} contracts = ${o.shares.toLocaleString("en-US")} shares`
                          : ""}
                      </span>
                      <span class="oval">
                        ~{o.estLabel}
                        {o.pctPortfolio != null ? ` · ${o.pctPortfolio}%` : ""}
                      </span>
                    </div>
                  ))}
                </div>
                <p class="fineprint mt-3">
                  One contract carries 100 shares, so a contract count states
                  the shares the position controls. The amount and the share
                  of the portfolio both come from the disclosed purchase
                  bracket, not from what the contracts are worth today. A
                  contract count appears only where the filing stated one.
                </p>
              </>
            )
          }

          {m.holdings.sourceUrl && (
            <p class="fineprint mt-6">
              Baseline source:{" "}
              <a
                href={m.holdings.sourceUrl}
                class="underline underline-offset-2 hover:text-ink"
                rel="nofollow"
              >
                annual disclosure, filed {fmtMonth(m.holdings.filingDate)}
              </a>
              , then rolled forward with disclosed trades.
            </p>
          )}
        </section>
      )
    }

    {
      m.performance?.available && (
        <PerformanceChart perf={m.performance} name={m.name} />
      )
    }

    <section class="mx-auto max-w-[75rem] px-[5vw] pb-[6vh]">
      <div class="section-head">
        <h2 class="section-title whitespace-nowrap">Disclosed trades</h2>
        <span class="eyebrow">Most recent first</span>
      </div>

      <div id="tfilter" class="tctl" hidden>
        <label class="tctl-search">
          <span class="sr-only">Filter the trades</span>
          <input
            id="tfq"
            type="search"
            autocomplete="off"
            placeholder="Filter by ticker or company"
          />
        </label>
        <label class="tctl-pick">
          <span class="eyebrow">Side</span>
          <select id="tfside">
            <option value="">All</option>
            <option value="BUY">Buys</option>
            <option value="SELL">Sells</option>
          </select>
        </label>
        {
          hasBonds && hasEquities && (
            <label class="tctl-pick">
              <span class="eyebrow">Assets</span>
              <select id="tfasset">
                <option value="">All</option>
                <option value="eq">Stocks & options</option>
                <option value="bond">Bonds & munis</option>
              </select>
            </label>
          )
        }
        <p id="tfcount" class="eyebrow tctl-count" aria-live="polite" />
      </div>

      <p class="tswipe" aria-hidden="true">swipe →</p>
      <div class="tscroll">
        <div role="table" aria-label={`${m.name} disclosed trades`}>
          <div role="row" class="trow thead">
            <span role="columnheader">Ticker</span>
            <span role="columnheader">Side</span>
            <span role="columnheader">Amount</span>
            <span role="columnheader">Traded</span>
            <span role="columnheader">Filing</span>
          </div>
          {
            m.trades.map((t: any) => (
              <div
                role="row"
                class="trow"
                data-t={(t.ticker || "").toLowerCase()}
                data-c={(t.asset || "").toLowerCase()}
                data-s={t.side.startsWith("SELL") ? "SELL" : t.side}
                data-b={t.bond ? "1" : ""}
              >
                <div role="cell" class="ttick">
                  {t.ticker}
                  <small>{t.asset}</small>
                </div>
                <div
                  role="cell"
                  class={`tside font-semibold ${t.side === "BUY" ? "text-buy" : "text-sell"}`}
                >
                  {t.side}
                </div>
                <div role="cell" class="tamt">{t.amountBucket}</div>
                <div role="cell" class="tdate">
                  {fmtDate(t.txDate)}
                  <small>filed {fmtDate(t.filedDate)}</small>
                </div>
                <div role="cell" class="tlate">
                  {t.daysLate && t.daysLate > 0 ? (
                    <span class="latebad">{t.daysLate}d late</span>
                  ) : (
                    <span class="lateok">on time</span>
                  )}
                  {t.sourceUrl && (
                    <a
                      href={t.sourceUrl}
                      class="tsrc"
                      rel="nofollow"
                      aria-label="Official filing"
                    >
                      filing ↗
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <p id="tfempty" class="mt-6 text-ink-soft" hidden>
        No disclosed trade matches that filter.
        <button id="tfclear" class="tclear">Clear filters</button>
      </p>
      <button id="tfmore" class="tmore" hidden></button>

      <p class="fineprint mt-6 max-w-[80ch]">
        Amounts are the brackets as filed; "days late" counts days past the
        STOCK Act's 45-day maximum (<a
          href="/how-it-works"
          class="underline underline-offset-2 hover:text-ink">how we count</a
        >). See the full searchable history on the
        <a
          href="/#feed"
          class="underline underline-offset-2 hover:text-ink">live tracker</a
        >. Source: official House and Senate disclosure portals.
      </p>
    </section>

    <section class="border-t-2 border-ink px-[5vw] py-[10vh] text-center">
      <h2 class="text-[clamp(1.8rem,4.5vw,3.2rem)] font-black leading-[1.15] tracking-[-0.03em] text-balance">
        Know {m.name.split(" ").slice(-1)[0]}'s next trade first.
      </h2>
      <p class="mx-auto mt-4 mb-6 max-w-[46ch] text-pretty text-ink-soft">
        {s.trades.toLocaleString("en-US")} filings so far. The next one — and
        everyone else's — lands in one morning email.
      </p>
      <SignupForm variant="band" id="join" />
    </section>
    </main>


    <Footer />

    <SignupModal title={`Know ${m.name.split(' ').slice(-1)[0]}'s next trade first.`} />

    <CountUp />

    <script is:inline>
      // Filter + collapse for the disclosed-trades table. The full record
      // ships in the HTML (crawlers and no-JS readers see every row); this
      // only hides and reveals. Controls start hidden so a reader without
      // JavaScript never sees a control that cannot work.
      (function () {
        var box = document.getElementById("tfilter");
        var q = document.getElementById("tfq");
        var side = document.getElementById("tfside");
        var asset = document.getElementById("tfasset"); // absent on bond-less pages
        var count = document.getElementById("tfcount");
        var empty = document.getElementById("tfempty");
        var clear = document.getElementById("tfclear");
        var more = document.getElementById("tfmore");
        if (!box || !q || !side || !count || !empty || !clear || !more) return;

        var rows = Array.prototype.slice.call(
          document.querySelectorAll(".trow:not(.thead)"));
        var total = rows.length;
        var COLLAPSE_AT = 25;
        // Collapsed by default only when the table is long; filtering always
        // expands, because a filter over hidden rows lies about the record.
        var collapsed = total > COLLAPSE_AT + 5;

        function filtering() {
          return !!(q.value.trim() || side.value || (asset && asset.value));
        }

        function apply() {
          var term = q.value.trim().toLowerCase();
          var wantSide = side.value;
          var wantAsset = asset ? asset.value : "";
          var showAll = !collapsed || filtering();
          var shown = 0;
          rows.forEach(function (row) {
            var hit =
              (!term ||
                row.getAttribute("data-t").indexOf(term) !== -1 ||
                row.getAttribute("data-c").indexOf(term) !== -1) &&
              (!wantSide || row.getAttribute("data-s") === wantSide) &&
              (!wantAsset ||
                (wantAsset === "bond") === (row.getAttribute("data-b") === "1"));
            if (hit) shown++;
            row.hidden = !hit || (!showAll && shown > COLLAPSE_AT);
          });
          empty.hidden = shown !== 0;
          count.textContent =
            shown === total
              ? total + " trades"
              : shown + " of " + total + " trades";
          var canExpand = collapsed && !filtering() && shown > COLLAPSE_AT;
          more.hidden = !canExpand;
          if (canExpand) more.textContent = "Show all " + shown + " trades";
        }

        q.addEventListener("input", apply);
        side.addEventListener("change", apply);
        if (asset) asset.addEventListener("change", apply);
        more.addEventListener("click", function () {
          collapsed = false;
          apply();
        });
        clear.addEventListener("click", function () {
          q.value = "";
          side.value = "";
          if (asset) asset.value = "";
          apply();
        });
        box.hidden = false;
        apply();
      })();
    </script>
