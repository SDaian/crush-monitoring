---
// Shared site header (DESIGN.md §8 header primitive): wordmark left; mono nav
// + one filled CTA pill right; editorial 3px double rule beneath. `active`
// marks the current page; the brand links home. Whether this IS the home page
// comes from the URL, so pages outside the nav (like /privacy) still link back.
interface Props {
  active?: "how" | "late";
}
const { active } = Astro.props;
const home = Astro.url.pathname === "/";

const link =
  "mono ml-6 text-[.75rem] uppercase tracking-[.07em] no-underline " +
  "hover:text-ink focus-visible:text-ink";
const active_cls = "border-b-2 border-stamp pb-0.5 text-ink";
---

<header
  class="flex items-center justify-between border-b-[3px] border-double border-ink px-[5vw] py-4"
>
  <a
    href={home ? "#top" : "/"}
    class="text-[1.05rem] font-black uppercase tracking-[-0.02em] text-ink no-underline"
    aria-label="Capitol Ledger — home"
  >
    Capitol <span class="text-stamp">Ledger</span>
  </a>
  <nav class="flex items-center">
    <a href="/#feed" class={`${link} text-ink-soft`}>Live feed</a>
    <a
      href="/late"
      class={`${link} ${active === "late" ? active_cls : "text-ink-soft"}`}
      aria-current={active === "late" ? "page" : undefined}>Late filers</a
    >
    <a
      href="/how-it-works"
      class={`${link} ${active === "how" ? active_cls : "text-ink-soft"}`}
      aria-current={active === "how" ? "page" : undefined}>How it works</a
    >
    <a
      href="/#join"
      class="mono ml-6 whitespace-nowrap bg-ink px-3.5 py-2 text-[.75rem] uppercase tracking-[.06em] text-paper no-underline hover:bg-stamp focus-visible:bg-stamp"
      >Get alerts</a
    >
  </nav>
</header>
