---
// Shared site footer: brand blurb (the SEO copy names only politicians
// truly in the tracked data — Pelosi, Trump (executive 278-T filings),
// Tuberville, Greene — keep it that way), a sitemap, and the legal line.
const links = [
  { href: "/", label: "Home" },
  { href: "/#feed", label: "Live feed" },
  { href: "/late", label: "Late filers" },
  { href: "/how-it-works", label: "How it works" },
  { href: "/#join", label: "Get alerts" },
  { href: "/#contact", label: "Contact" },
  { href: "/privacy", label: "Privacy & terms" },
];
---

<footer class="border-t border-rule px-[5vw] pt-10 pb-6">
  <div
    class="mx-auto grid max-w-[75rem] grid-cols-[1.5fr_1fr] gap-10 max-[760px]:grid-cols-1"
  >
    <div>
      <a
        href="/"
        class="text-[.95rem] font-black uppercase tracking-[-0.02em] text-ink no-underline"
      >
        Capitol <span class="text-stamp">Ledger</span>
      </a>
      <p class="mt-3 max-w-[52ch] text-[.85rem] leading-[1.65] text-pretty text-ink-soft">
        Capitol Ledger tracks politician stock trading, from Congress to the
        White House, straight from official STOCK Act filings — Nancy
        Pelosi's disclosures, Donald Trump's filings, Tommy Tuberville's
        trades, Marjorie Taylor Greene's portfolio moves, and the members
        who file weeks past the 45-day deadline — in one daily email.
      </p>
    </div>
    <nav aria-label="Site map">
      <div class="eyebrow mb-3">
        Sitemap
      </div>
      <ul class="grid list-none grid-cols-2 gap-x-8 gap-y-2 p-0">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="mono text-[.78rem] uppercase tracking-[.06em] text-ink-soft no-underline hover:text-ink focus-visible:text-ink"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div
    class="mono mx-auto mt-9 flex max-w-[75rem] flex-wrap justify-between gap-2.5 border-t border-rule pt-5 text-[.75rem] text-ink-soft"
  >
    <span>© 2026 Capitol Ledger</span>
    <span>Data for informational purposes only. Not investment advice.</span>
  </div>
</footer>
