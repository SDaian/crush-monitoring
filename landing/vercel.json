{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/tickers/goog", "destination": "/tickers/googl", "permanent": true },
    { "source": "/tickers/goog/", "destination": "/tickers/googl", "permanent": true },
    { "source": "/tickers/fb", "destination": "/tickers/meta", "permanent": true },
    { "source": "/tickers/fb/", "destination": "/tickers/meta", "permanent": true }
  ]
}
