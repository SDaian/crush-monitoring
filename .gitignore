# Dependencies
node_modules/

# Playwright / test output — anchored to the repo root: an unanchored
# "reports/" also swallowed landing/src/data/reports (the report archive),
# which made the daily Action's git add fail the whole run.
/reports/
results.json
test-results/
playwright-report/

# Environment files
.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.pyc

# Congress fetcher scratch output (Action artifacts, never committed)
debug-dump/
fetch.log

# Python cache from the chat-style hook
.claude/hooks/__pycache__/

# Session-start hook virtualenv (web sessions)
.venv/
